          },
          "source": {
            "description": "The value as written, cut after 600 bytes (then it ends in `…`).",
            "type": "string"
          },
          "tier": {
            "anyOf": [
              {
                "$ref": "#/$defs/Tier"
              },
              {
                "type": "null"
              }
            ],
