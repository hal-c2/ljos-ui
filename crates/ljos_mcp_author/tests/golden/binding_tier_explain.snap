    "read_only": true
  },
  "description": "Say which tier each binding, handler and function of a QML file runs in (0: property path, 1: binding VM, js: JavaScript), why, and a cheaper form that means the same when one exists. Narrow with `line` (and `column`) or `property` (`width`, `label.width`, `onClicked`).",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "column": {
        "description": "1-based column on `line`: only the expression there, or the nearest\none on the line.",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "cursor": {
        "description": "`next_cursor` of the previous answer.",
        "type": [
          "string",
          "null"
        ]
      },
      "file": {
        "description": "A `.qml` file, relative to the project root.",
        "type": "string"
      },
      "line": {
        "description": "1-based line: only what is written on that line.",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "property": {
        "description": "Only this property, handler or function: `width`, `anchors.fill`,\n`onClicked`. Put the object's id or type in front when several\nobjects have it: `label.width`, `Text.width`.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "file"
    ],
    "title": "TierArgs",
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "binding_tier_explain",
