{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": true
  },
  "description": "A palette from a seed (`#rrggbb`, a colour name or a hue): twelve-step OKLCH ramps, the roles (surface, text, accent, onAccent, danger…), every contrast pair they pass, and hue harmonies at the seed's lightness.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "contrast": {
        "description": "`normal` (the default) or `high`: text at 7:1.",
        "type": [
          "string",
          "null"
        ]
      },
      "scheme": {
        "description": "`light` (the default) or `dark`.",
        "type": [
          "string",
          "null"
        ]
      },
      "seed": {
        "description": "`#rrggbb`, a colour name, or an OKLCH hue in degrees (`250`).",
        "type": "string"
      }
    },
    "required": [
      "seed"
    ],
    "title": "PaletteArgs",
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "design_palette",
  "outputSchema": {
    "$defs": {
