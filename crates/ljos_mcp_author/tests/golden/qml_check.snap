---
source: crates/ljos_mcp_author/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": true
  },
  "description": "Parse and resolve QML files, `.ts` and `.lts` modules or directories, with Ljós's syntax compiled away; returns diagnostics at their places in the files as written (file, line, column, severity, code, message), paginated.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "description": "Resume token from a previous truncated result.",
        "type": [
          "string",
          "null"
        ]
      },
      "paths": {
        "description": "`.qml` files, `.ts` and `.lts` modules or directories, relative to the\nproject root.",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "paths"
    ],
    "title": "FilesArgs",
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "qml_check",
  "outputSchema": {
    "$defs": {
      "Diagnostic": {
        "properties": {
          "code": {
            "type": "string"
          },
          "column": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "file": {
            "description": "Project-relative path.",
            "type": "string"
          },
          "fix": {
            "description": "For a design or declarative rule: what to write instead, in the rule's words.",
            "type": [
              "string",
              "null"
            ]
          },
          "guide": {
            "description": "For a design or declarative rule: its guideline, `docs/design/<page>#<code>` or `docs/declarative.md#<code>`.",
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/$defs/Severity"
          }
        },
        "required": [
          "file",
          "line",
          "column",
          "severity",
          "code",
          "message"
        ],
        "type": "object"
      },
      "Severity": {
        "enum": [
          "error",
          "warning",
          "hint"
        ],
        "type": "string"
      }
    },
    "properties": {
      "diagnostics": {
        "items": {
          "$ref": "#/$defs/Diagnostic"
        },
        "type": "array"
      },
      "next_cursor": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "diagnostics"
    ],
    "title": "DiagnosticsOut",
    "type": "object"
  },
  "required_cap": null
}
