<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- What the package's [package.metadata.ljos.android] permissions
         declares: the system denies a runtime permission the manifest
         does not, without asking. -->
    @PERMISSIONS@
    <application
        android:label="@LABEL@"
        android:hasCode="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">
        <!-- Every configuration change goes to the running application,
             which resizes; none makes the activity again. -->
        <activity
            android:name="dev.ljos.LjosActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection|colorMode|touchscreen|grammaticalGender">
            <meta-data android:name="android.app.lib_name" android:value="@LIB_NAME@" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A picture the application copies is on the clipboard as a
             content URI of this provider, which lends it to whoever
             pastes it (LjosServices.setClipboardImage). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ljos.clipboard"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ljos_clipboard_paths" />
        </provider>
    </application>
</manifest>
