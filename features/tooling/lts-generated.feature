# Sources:
#   docs/DIALECT.md (§4.21: what stock TypeScript reads of an `.lts` module; §5.1: lts-export-type, tsconfig-lts)
#   https://www.typescriptlang.org/tsconfig/#allowArbitraryExtensions
#   https://www.typescriptlang.org/tsconfig/#rootDirs
#   https://www.typescriptlang.org/tsconfig/#isolatedDeclarations
# `.lts` modules and the directory written for them are Ljós's own: Qt has nothing to compare them with.
# A file given here keeps the six spaces its doc string is indented by, except one given
# "without its indentation"; a file compared with one is compared without them.

@ljos-only @headless
Feature: The generated directory lets stock TypeScript read `.lts` modules
  Stock TypeScript cannot read an `.lts` module, so `ljos check` and
  `ljos types` write what it reads instead: a declaration for each
  module, beside a base `tsconfig.json` that maps the module's place to
  its declaration's. They write it in `.ljos/` under the project's root,
  only what changed, and nothing outside it. A declaration whose module
  is gone goes with it.

  Scenario: Checking writes the base tsconfig and keeps the directory out of version control
    Given the file "width.lts":
      """ts
      export function width(thick: boolean): number {
        return match (thick) {
          when true: 3;
          when false: 1;
        }
      }
      """
    And the file "tsconfig.json":
      """json
      { "extends": "./.ljos/tsconfig.base.json" }
      """
    When the files are checked
    Then the check reports:
      """
      1 files, 0 errors, 0 warnings
      """
    And the file ".ljos/tsconfig.base.json" is:
      """json
      { "compilerOptions": { "allowArbitraryExtensions": true, "rootDirs": ["..", "./types"] } }
      """
    And the file ".ljos/.gitignore" is:
      """
      *
      """
    And the file ".ljos/types/width.d.lts.ts" is:
      """ts
      // Generated by ljos check from width.lts; do not edit.
      export declare function width(thick: boolean): number;
      """

  Scenario: A declaration whose module is gone is removed, and one whose module is there is rewritten
    Given the file "width.lts":
      """ts
      export const thin: number = 1
      """
    And the file "tsconfig.json":
      """json
      { "extends": "./.ljos/tsconfig.base.json" }
      """
    And the file ".ljos/types/gone.d.lts.ts":
      """ts
      export declare const gone: number;
      """
    And the file ".ljos/types/width.d.lts.ts":
      """ts
      export declare const thick: number;
      """
    When the files are checked
    Then the check reports:
      """
      1 files, 0 errors, 0 warnings
      """
    And the check left no file ".ljos/types/gone.d.lts.ts"
    And the file ".ljos/types/width.d.lts.ts" is:
      """ts
      // Generated by ljos check from width.lts; do not edit.
      export declare const thin: number;
      """

  Scenario: A module that has no declaration keeps the one it had
    Given the file "width.lts" without its indentation:
      """ts
      export const thin = [1].length
      """
    And the file "tsconfig.json":
      """json
      { "extends": "./.ljos/tsconfig.base.json" }
      """
    And the file ".ljos/types/width.d.lts.ts":
      """ts
      export declare const thin: number;
      """
    When the files are checked
    Then the check reports:
      """
      width.lts:1:14: error: `thin` is exported from an `.lts` module, so its value needs a declared type for the module's declaration [lts-export-type]
      1 files, 1 errors, 0 warnings
      ljos: 1 errors
      """
    And the file ".ljos/types/width.d.lts.ts" is:
      """ts
      export declare const thin: number;
      """

  Scenario: Writing the declarations again writes nothing
    Given the file "width.lts":
      """ts
      export const thin: number = 1
      """
    And the file "tsconfig.json":
      """json
      { "extends": "./.ljos/tsconfig.base.json" }
      """
    When the declarations of the files are written twice
    Then the check reports:
      """
      wrote .ljos/.gitignore
      wrote .ljos/tsconfig.base.json
      wrote .ljos/types/width.d.lts.ts
      1 modules, 3 files written, 0 removed
      1 modules, 0 files written, 0 removed
      """

  Scenario: The root is the nearest directory up that has a tsconfig.json
    Given the file "src/width.lts":
      """ts
      export const thin: number = 1
      """
    And the file "tsconfig.json":
      """json
      { "extends": "./.ljos/tsconfig.base.json" }
      """
    When the files in "src" are checked
    Then the check reports:
      """
      1 files, 0 errors, 0 warnings
      """
    And the file ".ljos/types/src/width.d.lts.ts" is:
      """ts
      // Generated by ljos check from src/width.lts; do not edit.
      export declare const thin: number;
      """
    And the check left no file "src/.ljos/types/width.d.lts.ts"

  Scenario: The root is the directory the check is told it is
    Given the file "app/width.lts":
      """ts
      export const thin: number = 1
      """
    And the file "app/tsconfig.json":
      """json
      { "extends": "./.ljos/tsconfig.base.json" }
      """
    When the files are checked with the project root "app"
    Then the check reports:
      """
      1 files, 0 errors, 0 warnings
      """
    And the file "app/.ljos/types/width.d.lts.ts" is:
      """ts
      // Generated by ljos check from width.lts; do not edit.
      export declare const thin: number;
      """
    And the check left no file ".ljos/tsconfig.base.json"

  Scenario: A tsconfig.json with rootDirs of its own is a warning where it names them
    Given the file "width.lts":
      """ts
      export const thin: number = 1
      """
    And the file "tsconfig.json" without its indentation:
      """json
      {
        "extends": "./.ljos/tsconfig.base.json",
        "compilerOptions": { "rootDirs": ["src", "gen"] }
      }
      """
    When the files are checked
    Then the check reports:
      """
      tsconfig.json:3:24: warning: the `rootDirs` of `tsconfig.json` replace those of `./.ljos/tsconfig.base.json`, so stock TypeScript cannot resolve an import of `width.lts`; `ljos migrate` adds "." and ".ljos/types" to them [tsconfig-lts]
      1 files, 0 errors, 1 warnings
      """

  Scenario: A tsconfig.json whose rootDirs have the generated directory is not a warning
    Given the file "width.lts":
      """ts
      export const thin: number = 1
      """
    And the file "tsconfig.json":
      """json
      {
        "extends": "./.ljos/tsconfig.base.json",
        "compilerOptions": { "rootDirs": ["src", ".", ".ljos/types"] }
      }
      """
    When the files are checked
    Then the check reports:
      """
      1 files, 0 errors, 0 warnings
      """

  # Through `--tsc`, an `.lts` module's body is TypeScript's to check too.
  Scenario: TypeScript's error in an `.lts` module is reported where it is in the module
    Given the file "width.lts" without its indentation:
      """ts
      export function width(thick: boolean): number {
        const name: string = match (thick) {
          when true: 3;
          when false: 1;
        }
        return name.length
      }
      """
    And the file "Line.qml" without its indentation:
      """qml
      import Ljos.Ui
      import "width.lts" as W
      Item {
        property real w: W.width(true)
      }
      """
    And the file "tsconfig.json":
      """json
      { "extends": "./.ljos/tsconfig.base.json" }
      """
    When the files are checked with TypeScript
    Then TypeScript reports the lines:
      """
      width.lts:2:9: error: Type 'number' is not assignable to type 'string'. [TS2322]
      """

  Scenario: TypeScript reads a `match` in a QML file where it is written
    Given the file "Line.qml" without its indentation:
      """qml
      import Ljos.Ui
      Item {
        property bool thick: false
        function width(): string {
          const w: string = match (thick) {
            when true: 3;
            when false: 1;
          }
          return w
        }
      }
      """
    When the files are checked with TypeScript
    Then TypeScript reports the lines:
      """
      Line.qml:5:11: error: Type 'number' is not assignable to type 'string'. [TS2322]
      """

  Scenario: TypeScript reads an `.lts` module a `.ts` module imports through its declaration
    Given the file "width.lts":
      """ts
      export function width(thick: boolean): number {
        return match (thick) {
          when true: 3;
          when false: 1;
        }
      }
      """
    And the file "line.ts":
      """ts
      import { width } from "./width.lts"
      export const wide: number = width(true)
      """
    And the file "Line.qml":
      """qml
      import Ljos.Ui
      import "line.ts" as L
      Item {
        property real w: L.wide
      }
      """
    And the file "tsconfig.json":
      """json
      { "extends": "./.ljos/tsconfig.base.json" }
      """
    When the files are checked with TypeScript
    Then TypeScript reports nothing
