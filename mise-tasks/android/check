#!/usr/bin/env bash
#MISE description="cargo check for Android with the NDK's compiler, for each ABI Ljós builds (arm64-v8a, x86_64): android:check [--abi ABI] [cargo args, default -p ljos_js]"
#MISE dir="{{config_root}}"
#USAGE flag "--abi <abi>" help="One ABI (arm64-v8a or x86_64) instead of both"
#USAGE arg "[args]..." var=#true help="What to check (default -p ljos_js)"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../_lib/env.sh
. "$(dirname "$0")/../_lib/env.sh"
# shellcheck source-path=SCRIPTDIR source=../_lib/android.sh
. "$(dirname "$0")/../_lib/android.sh"
cd "$ljos_root"
need_pinned_rust
abis="$android_abis"
if [ "${1:-}" = "--abi" ]; then
  abis="${2:?--abi needs an ABI}"
  shift 2
fi
[ $# -gt 0 ] || set -- -p ljos_js
for abi in $abis; do
  triple="$(android_rust_target "$abi")"
  need_rust_target "$triple"
  (
    android_cross_env "$triple"
    cargo check --target "$triple" "$@"
  )
done
