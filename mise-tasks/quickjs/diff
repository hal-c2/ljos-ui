#!/usr/bin/env bash
#MISE description="Diff the vendored rquickjs-sys and rquickjs-core forks against the crates.io releases they are based on"
set -euo pipefail
# What vendor/QUICKJS.md says the patch is, checked against what it really is.
# The fork keeps only the files its build reads (vendor/QUICKJS.md), so what
# it leaves out is listed once as "Only in" and not printed as a deletion.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
status=0
for crate in rquickjs-sys rquickjs-core; do
  version=$(sed -n 's/^version = "\(.*\)"$/\1/p' "vendor/$crate/Cargo.toml" | head -n 1)
  curl -sSfL "https://static.crates.io/crates/$crate/$crate-$version.crate" | tar -xz -C "$work"
  # diff exits 1 when there are differences, which there always are.
  diff -ru -x Cargo.toml.orig -x .cargo_vcs_info.json -x Cargo.lock \
    "$work/$crate-$version" "vendor/$crate" "$@" | sed "s|$work/||" || [ "${PIPESTATUS[0]}" -eq 1 ] || status=1
done
exit "$status"
