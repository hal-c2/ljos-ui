#!/usr/bin/env bash
#MISE description="Measure QML apps on Ljós (release, or BENCH_PROFILE=dist) and Qt (qml6) inside systemd scopes in the headless sandbox: bench [ids…] [ljos bench options…]; ids are bench/*.qml names and corpus examples (by default all qml6 runs; one named that it cannot run is measured without it); report in target/bench"
#MISE dir="{{config_root}}"
#USAGE arg "[ids]..." var=#true help="bench/*.qml names and corpus example ids (default: every one qml6 runs), then options for ljos bench (ljos bench --help), which override BENCH_DEFAULTS"
set -euo pipefail
# Options after the ids go to `ljos bench` after the defaults and override
# them; `ljos bench --help` lists them. BENCH_DEFAULTS replaces the defaults
# (BENCH_DEFAULTS= for none). A long run can be made in parts with --append.
# BENCH_PROFILE=dist measures the binary that is handed out (one LLVM
# module, a much longer build) instead of release. See docs/BENCHMARKS.md.
# shellcheck source-path=SCRIPTDIR source=../_lib/env.sh
. "$(dirname "$0")/../_lib/env.sh"
root="$ljos_root"
target="$(target_dir)"
out="${BENCH_DIR:-$(checkout_dir bench)}"

read -r -a defaults <<< "${BENCH_DEFAULTS---warm-up --repeat 3 --bisect pi-zero}"
ids=()
opts=()
for a in "$@"; do
  if [[ $a == -* || ${#opts[@]} -gt 0 ]]; then opts+=("$a"); else ids+=("$a"); fi
done
need_python3
need_systemd_run
qt=false
qml="$(bench_qml6 ${defaults[@]+"${defaults[@]}"} ${opts[@]+"${opts[@]}"})"
if bench_has_qt ${defaults[@]+"${defaults[@]}"} ${opts[@]+"${opts[@]}"}; then
  QML6="$qml" need_qml6
  qt=true
fi
# The apps run on the sandbox's Wayland; a desktop platform theme (gtk3,
# qt6ct) would load a desktop's plugin into qml6 there.
unset QT_QPA_PLATFORMTHEME

# The release build is what is measured unless BENCH_PROFILE names
# another; nothing compiles while it runs. BENCH_BUILD=0 measures what is
# already built, when the build was made another way (a shared build
# queue, another toolchain) or must not be made again.
profile="${BENCH_PROFILE:-release}"
case "$profile" in
  release) build="lto thin" ;;
  dist) build="lto fat, one codegen unit" ;;
  *)
    echo "BENCH_PROFILE is release or dist, not $profile" >&2
    exit 2
    ;;
esac
# A build is measured through the run's own link to it (pin_programs): the
# target may be shared with another checkout, whose build would otherwise
# be measured as this one's.
if [[ ${BENCH_BUILD:-1} != 0 ]]; then
  programs="$(pin_programs "$out/bin" build --quiet --profile "$profile" -p ljos_cli --bin ljos)" || die "bench: ljos did not build"
  ljos="$(pinned_program ljos "$programs")"
  [ -n "$ljos" ] || die "bench: the build made no ljos"
  cargo build --quiet -p qml_compare
else
  ljos="$target/$profile/ljos"
fi

manifest="$out/manifest.json"
# The examples the gallery rendered and the controls gallery:drive clicked,
# in this checkout's corner of the target.
GALLERY_DIR="${GALLERY_DIR:-$(checkout_dir gallery)}" "$root/scripts/bench-manifest.sh" "$out" ${ids[@]+"${ids[@]}"}

# The sandbox's compositor: the bench watches it map windows, clicks it and
# counts its frames; the user's display is never used.
sandbox="$("$root/scripts/cua-sandbox.sh" env)"
value() { sed -n "s/^$1=//p" <<< "$sandbox"; }

# qml6 aborts on --version without a display, hence offscreen for the note.
qt_note="qt: not measured"
if [ "$qt" = true ]; then
  qt_note="qt: $(QT_QPA_PLATFORM=offscreen "$qml" --version 2>&1 | sed -n 1p), QT_QUICK_CONTROLS_STYLE=Basic"
fi
exec "$ljos" bench --manifest "$manifest" \
  --sway "$(value SWAYSOCK)" --wayland "$(value WAYLAND_DISPLAY)" \
  --app-env "DBUS_SESSION_BUS_ADDRESS=$(value DBUS_SESSION_BUS_ADDRESS)" \
  --app-env "XDG_CONFIG_HOME=$(value XDG_CONFIG_HOME)" --app-env "XDG_DATA_HOME=$(value XDG_DATA_HOME)" \
  --app-env "XDG_STATE_HOME=$(value XDG_STATE_HOME)" \
  --app-env "LJOS_SCREEN_READER=$(value LJOS_SCREEN_READER)" \
  --qml6 "$qml" ${defaults[@]+"${defaults[@]}"} \
  --note "ljos: $(git -C "$root" rev-parse --short HEAD), cargo build --profile $profile ($build)" \
  --note "$qt_note" \
  --note "both on the sandbox's headless sway (${LJOS_CUA_GPU:-pixman}), as Wayland clients" \
  --out "$out" ${opts[@]+"${opts[@]}"}
