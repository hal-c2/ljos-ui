#!/usr/bin/env bash
#MISE description="Measure QML apps on Ljós (release) and Qt (qml6) inside systemd scopes in the headless sandbox: bench [ids…] [ljos bench options…]; ids are bench/*.qml names and runnable corpus examples (all by default); report in target/bench"
#MISE dir="{{config_root}}"
set -euo pipefail
# Options after the ids go to `ljos bench` after the defaults and override
# them; `ljos bench --help` lists them. BENCH_DEFAULTS replaces the defaults
# (BENCH_DEFAULTS= for none). A long run can be made in parts with --append.
# See docs/BENCHMARKS.md.
root="$(pwd)"
target="${CARGO_TARGET_DIR:-$root/target}"
out="${BENCH_DIR:-$target/bench}"

read -r -a defaults <<< "${BENCH_DEFAULTS---warm-up --repeat 3 --bisect pi-zero}"
ids=()
opts=()
for a in "$@"; do
  if [[ $a == -* || ${#opts[@]} -gt 0 ]]; then opts+=("$a"); else ids+=("$a"); fi
done

# The release build is what is measured; nothing compiles while it runs.
cargo build --quiet --release -p ljos_cli
cargo build --quiet -p qml_compare

mkdir -p "$out"
manifest="$out/manifest.json"
overlays="$out/overlay"
# The examples that rendered in the last gallery run are the ones that run
# under both; with no gallery run, every runnable one.
gallery="${GALLERY_DIR:-$target/gallery}/report.json"
rows="$("$target/debug/qml-compare" list --manifest "$root/corpus/examples.json" --runnable)"
while IFS=$'\t' read -r id dir _; do
  [[ -n $id ]] || continue
  rm -rf "${overlays:?}/$id"
  mkdir -p "$overlays/$id"
  # Examples built with CMake name their modules there; a qmldir per module
  # lets plain qml6 find them, as for the gallery's reference pictures.
  "$root/corpus/harness/overlay.sh" "$dir" "$overlays/$id"
done <<< "$rows"

ROWS="$rows" python3 - "$root" "$overlays" "$gallery" "$manifest" "${ids[@]}" <<'PY'
import json, os, re, sys
root, overlays, gallery, manifest, *wanted = sys.argv[1:]
renders = None
try:
    renders = {e["id"] for e in json.load(open(gallery)) if e.get("renders")}
except OSError:
    pass
apps = []
for name in sorted(os.listdir(os.path.join(root, "bench"))):
    if not name.endswith(".qml"):
        continue
    path = os.path.join(root, "bench", name)
    text = open(path).read()
    w = re.search(r"\bwidth:\s*(\d+)", text)
    h = re.search(r"\bheight:\s*(\d+)", text)
    app = {"id": name[:-4], "file": path, "imports": [os.path.dirname(path)]}
    if w and h:
        app["size"] = f"{w.group(1)}x{h.group(1)}"
    apps.append(app)
for line in os.environ["ROWS"].splitlines():
    cid, d, entry, width, height, *_ = line.split("\t")
    if renders is not None and cid not in renders:
        continue
    apps.append({
        "id": cid,
        "file": os.path.join(d, entry),
        "imports": [d, os.path.join(overlays, cid)],
        "size": f"{width}x{height}",
        # The example's directory is its project, as for the gallery.
        "ljos_args": ["--project", d, "--example", cid],
    })
if wanted:
    known = {a["id"] for a in apps}
    missing = [w for w in wanted if w not in known]
    if missing:
        sys.exit(f"no bench app {', '.join(missing)}; the apps are: {', '.join(sorted(known))}")
    apps = [a for a in apps if a["id"] in wanted]
json.dump({"apps": apps}, open(manifest, "w"), indent=1)
print(f"{len(apps)} apps in {manifest}", file=sys.stderr)
PY

# The sandbox's compositor: the bench watches it map windows, clicks it and
# counts its frames; the user's display is never used.
sandbox="$("$root/scripts/cua-sandbox.sh" env)"
value() { sed -n "s/^$1=//p" <<< "$sandbox"; }

exec "$target/release/ljos" bench --manifest "$manifest" \
  --sway "$(value SWAYSOCK)" --wayland "$(value WAYLAND_DISPLAY)" \
  --app-env "DBUS_SESSION_BUS_ADDRESS=$(value DBUS_SESSION_BUS_ADDRESS)" \
  "${defaults[@]}" \
  --note "ljos: $(git -C "$root" rev-parse --short HEAD), cargo build --release (lto thin)" \
  --note "qt: $(qml6 --version 2>&1 | head -1), QT_QUICK_CONTROLS_STYLE=Basic" \
  --note "both on the sandbox's headless sway (pixman), as Wayland clients" \
  --out "$out" "${opts[@]}"
