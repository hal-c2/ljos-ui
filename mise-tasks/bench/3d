#!/usr/bin/env bash
#MISE description="Measure the QtQuick3D scenes (bench/quick3d-*.qml and the corpus's 3D apps) on Ljós and Qt (qml6) with what each 3D frame cost: bench:3d [ids…] [ljos bench options…]; report in target/bench3d, Qt's renderStats in target/bench3d/qml6-renderstats.json"
#MISE dir="{{config_root}}"
set -euo pipefail
# `mise run bench` with --frames3d, so Ljós's report has each 3D frame's
# counts (draw calls, pipeline switches, uploads, the CPU parts, the GPU
# time; docs/quick3d-perf.md), then the same scenes on qml6 once more under
# bench/quick3d/renderstats-probe.qml, which logs Qt's own renderStats:
# Qt's frames cannot be counted from outside. Run it with
# LJOS_CUA_GPU=/dev/dri/renderD128 and a LJOS_CUA_HOME of its own to
# measure on the GPU. Without it, qml6 draws on llvmpipe, while Ljós draws on
# the processor with its 3D still on a GPU it can open; `--app-env
# WGPU_BACKEND=gl --app-env LIBGL_ALWAYS_SOFTWARE=1` holds that to llvmpipe
# too (docs/quick3d-perf.md). The corpus apps whose
# build downloads assets need `mise run gallery:assets <id>` first.
# BENCH_3D_PROBE_SECONDS (default 10) is how long the probe runs a scene;
# 0 leaves the probe out. BENCH_QT (default: dice and the FX showroom, which
# qml6 6.12 runs with their stand-ins although corpus/examples.json says it
# cannot) names corpus apps to measure on qml6 all the same.
root="$(pwd)"
target="${CARGO_TARGET_DIR:-$root/target}"
# Absolute: the probe runs each scene where the bench ran it.
out="$(realpath -m "${BENCH_DIR:-$target/bench3d}")"

ids=()
opts=()
for a in "$@"; do
  if [[ $a == -* || ${#opts[@]} -gt 0 ]]; then opts+=("$a"); else ids+=("$a"); fi
done
if [[ ${#ids[@]} -eq 0 ]]; then
  ids=(quick3d-cube quick3d-gltf quick3d-grid quick3d-instances quick3d-post quick3d-shadows
    quick3d-spin quick3d-stress dice robotarm toycustomizer car-configurator fx-material-showroom)
fi

# The desktop profile and no memory bisection: what is measured here is
# frames, on the machine as it is (`--profile pi-zero` after the ids adds
# the small board).
BENCH_QT="${BENCH_QT-dice fx-material-showroom}" BENCH_DIR="$out" BENCH_DEFAULTS="${BENCH_DEFAULTS---warm-up --repeat 3 --profile desktop}" \
  "$root/mise-tasks/bench/_default" "${ids[@]}" --frames3d ${opts[@]+"${opts[@]}"}

seconds="${BENCH_3D_PROBE_SECONDS:-10}"
[[ $seconds == 0 ]] && exit 0
# The sandbox's commands get its X display, not its Wayland socket; Qt
# draws QtQuick3D on Wayland there, as the bench runs it.
wayland="$("$root/scripts/cua-sandbox.sh" env | sed -n 's/^WAYLAND_DISPLAY=//p')"
logs="$out/qml6"
# This run's scenes only: the summary reads every log in it.
rm -rf "$logs"
mkdir -p "$logs"
python3 - "$out/manifest.json" <<'PY' |
import json, sys
for app in json.load(open(sys.argv[1]))["apps"]:
    # The bench left qml6 out for it, and so does the probe (BENCH_QT's
    # apps are not marked).
    if not app.get("qt", True):
        continue
    # The app's environment as the bench gave it (a stand-in may read the
    # example's files), its pairs apart from the imports.
    env = "\x1f".join(f"{k}={v}" for k, v in sorted(app.get("env", {}).items()))
    print("\t".join([app["id"], app["file"], app.get("dir") or ".", env or "-", *app.get("imports", [])]))
PY
  while IFS=$'\t' read -r id file dir env imports; do
    args=()
    for i in $imports; do args+=(-I "$i"); done
    envs=()
    [[ $env == - ]] || IFS=$'\x1f' read -r -a envs <<<"$env"
    echo "bench:3d: qml6 renderStats of $id for ${seconds}s" >&2
    # qml6 logs to the journal unless told otherwise; the probe's lines are
    # wanted, and a scene that fails to load says so in them.
    # Where the bench ran it: an example reads its downloaded assets from there.
    # QSG_RHI_PROFILE asks Qt for the GPU timestamps lastCompletedGpuTime
    # comes from, which it leaves off otherwise.
    (cd "$dir" && "$root/scripts/cua-sandbox.sh" exec env WAYLAND_DISPLAY="$wayland" QT_FORCE_STDERR_LOGGING=1 QT_QPA_PLATFORM=wayland QSG_RHI_PROFILE=1 \
      QT_QUICK_CONTROLS_STYLE=Basic ${envs[@]+"${envs[@]}"} timeout "$seconds" qml6 ${args[@]+"${args[@]}"} \
      "$root/bench/quick3d/renderstats-probe.qml" -- "$file" > "$logs/$id.log" 2>&1 < /dev/null) || true
  done

python3 "$root/bench/quick3d/renderstats-summary.py" "$logs" "$out/qml6-renderstats.json"
