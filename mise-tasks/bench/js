#!/usr/bin/env bash
#MISE description="JavaScript cost on Ljós and qml6 (docs/BENCHMARKS.md, JS1): wall ms of each bench/js1 program, best of 5, and callgrind instructions per round. Takes bench names (all by default). Needs a release ljos, valgrind and Qt 6's qmltestrunner (NO_QT=1 measures Ljós only)"
#MISE dir="{{config_root}}"
#USAGE arg "[benches]..." var=#true help="bench/js1 program names (default: bindings handlers arrays strings json math props model)"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../_lib/env.sh
. "$(dirname "$0")/../_lib/env.sh"
cd "$ljos_root"
# LJOS is the binary measured (a release build), else this checkout's
# release build, the run's own link to it (pin_programs): the target may be
# shared with another checkout, whose release ljos would otherwise be
# measured as this one. QMLTESTRUNNER is Qt 6's (Qt 5's is the one on PATH
# on some systems); NO_QT=1 measures Ljós only.
out="$(from_asked "${OUT:-$(checkout_dir bench-js)}")"
need_valgrind
need_timeout
if [ -n "${LJOS:-}" ]; then
  ljos="$(from_asked "$LJOS")"
  [ -x "$ljos" ] || die "bench:js measures a release ljos, and LJOS=$ljos is not one: unset LJOS to build this checkout's"
else
  programs="$(pin_programs "$out/bin" build --quiet --release -p ljos_cli --bin ljos)" || die "bench:js: the release ljos did not build"
  ljos="$(pinned_program ljos "$programs")"
  [ -n "$ljos" ] || die "bench:js: the build made no ljos"
fi
qt=
if [ -z "${NO_QT:-}" ]; then
  qt="$(find_qmltestrunner)"
fi
export QT_FORCE_STDERR_LOGGING=1
qt_offscreen
# Nothing is measured with motion reduced (`ljos bench --check-motion`
# says why, and exits 2).
"$ljos" bench --check-motion

# Rounds for the wall clock, and for the instruction count (which also runs
# twice as many: the difference over the rounds is one round's cost, with
# start-up and the set-up before the clock taken out). Functions, not
# associative arrays, which macOS's bash 3.2 lacks.
wall() {
  case "$1" in
    bindings) echo 20000 ;;
    handlers | math | props) echo 1000000 ;;
    arrays) echo 50 ;;
    strings) echo 200 ;;
    json) echo 40 ;;
    model) echo 100 ;;
    *) die "bench:js has no bench $1 (bindings handlers arrays strings json math props model)" ;;
  esac
}
count() {
  case "$1" in
    bindings) echo 500 ;;
    handlers | math | props) echo 20000 ;;
    arrays | json) echo 2 ;;
    strings) echo 5 ;;
    model) echo 4 ;;
    *) die "bench:js has no bench $1 (bindings handlers arrays strings json math props model)" ;;
  esac
}
benches=("$@")
[ ${#benches[@]} -gt 0 ] || benches=(bindings handlers arrays strings json math props model)
# Every name is checked before anything runs.
for b in "${benches[@]}"; do
  wall "$b" >/dev/null
  [ -f "bench/js1/$b.qml" ] || die "bench:js: no bench/js1/$b.qml"
done

# A directory holding the bench as a test file, with its rounds.
program() {
  local d="$out/gen/$1-$2"
  mkdir -p "$d"
  sed "s/property int rounds: 1\$/property int rounds: $2/" "$ljos_root/bench/js1/$1.qml" >"$d/tst_$1.qml"
  echo "$d"
}
run() {
  if [ "$1" = qt ]; then timeout 300 "$qt" -input "$2" 2>&1; else timeout 300 "$ljos" test "$2" 2>&1; fi
}
ms() { awk '/qml: ms / && !m { for (i = 1; i < NF; i++) if ($i == "ms") m = $(i + 1) } END { print m }'; }
ir() {
  local f="$out/cg.$1" s=0 c
  rm -f "$f".*
  if [ "$1" = qt ]; then
    valgrind --tool=callgrind --callgrind-out-file="$f.%p" "$qt" -input "$2" >/dev/null 2>&1
  else
    valgrind --tool=callgrind --callgrind-out-file="$f.%p" "$ljos" test "$2" >/dev/null 2>&1
  fi
  for c in "$f".*; do s=$((s + $(awk '/^summary:/ { print $2 }' "$c"))); done
  rm -f "$f".*
  echo "$s"
}

printf '%-9s %-5s %8s %14s\n' bench on wall_ms ir_per_round
for b in "${benches[@]}"; do
  n="$(count "$b")"
  dw="$(program "$b" "$(wall "$b")")"
  d1="$(program "$b" "$n")"
  d2="$(program "$b" $((n * 2)))"
  for on in ljos qt; do
    if [ "$on" = qt ] && [ -z "$qt" ]; then continue; fi
    best=
    for _ in 1 2 3 4 5; do
      m="$(run "$on" "$dw" | ms)"
      if [ -z "$best" ] || [ "$m" -lt "$best" ]; then best=$m; fi
    done
    i1="$(ir "$on" "$d1")"
    i2="$(ir "$on" "$d2")"
    printf '%-9s %-5s %8s %14s\n' "$b" "$on" "$best" $(((i2 - i1) / n))
  done
done
