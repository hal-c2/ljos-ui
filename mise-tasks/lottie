#!/usr/bin/env bash
#MISE description="Play a Lottie file in a window: lottie [file.json|file.qml] [--qt] [--check] [ljos run args…]; bench/lottie/mid.json by default, --qt plays it on qml6 instead, click to pause. --check builds it and plays it for 2 s with no window"
#MISE dir="{{config_root}}"
#USAGE arg "[file]" help="Lottie .json or a .qml that plays one (default bench/lottie/mid.json)"
#USAGE flag "--qt" help="Play it on qml6 instead (comes right after the file)"
#USAGE flag "--check" help="Build ljos (debug: no frame is timed) and play the file for 2 s with no window or display, then stop; with --qt, only see that qml6 is there. Fails when it does not build or load"
#USAGE arg "[args]..." var=#true help="Arguments for ljos run"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=_lib/env.sh
. "$(dirname "$0")/_lib/env.sh"
cd "$ljos_root"
root="$ljos_root"
target="$(target_dir)"

check=
args=()
for a in "$@"; do
  if [ "$a" = --check ]; then check=1; else args+=("$a"); fi
done
set -- ${args[@]+"${args[@]}"}
file="$root/bench/lottie/mid.json"
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
  file="$(from_asked "$1")"
  shift
fi
qt=
if [ $# -gt 0 ] && [ "$1" = --qt ]; then
  qt=1
  shift
fi
[ -f "$file" ] || die "lottie: no such file: $file"

# A .qml is played as it is; a bare .json gets a small viewer, so any file
# downloaded from the web can be tried without writing QML for it.
case "$file" in
  *.qml) entry="$file" ;;
  *)
    dir="$target/lottie"
    mkdir -p "$dir"
    entry="$dir/view.qml"
    url="file://$file"
    # A check is told what the animation came to: LottieAnimation reports a
    # file it cannot read as its status, not as a QML error. It is told at
    # completion too, as the status may be Ready before a change is seen.
    said=""
    [ -z "$check" ] || said='function said() { console.log("lottie --check: " + ["Null", "Loading", "Ready", "Error"][status]) }
        onStatusChanged: said()
        Component.onCompleted: said()'
    cat > "$entry" <<EOF
import QtQuick
import Qt.labs.lottieqt

Rectangle {
    width: 640
    height: 680
    color: "#202020"

    LottieAnimation {
        id: anim
        anchors.centerIn: parent
        source: "$url"
        loops: LottieAnimation.Infinite
        $said
    }

    MouseArea {
        anchors.fill: parent
        onClicked: anim.togglePause()
    }

    Text {
        anchors.bottom: parent.bottom
        anchors.margins: 8
        x: 8
        color: "white"
        text: "$(basename "$file") · " + ["Null", "Loading", "Ready", "Error"][anim.status]
              + " · " + anim.frameRate + " fps · frames " + anim.startFrame + "–" + anim.endFrame
              + " · click to pause"
    }
}
EOF
    ;;
esac

if [ -n "$qt" ]; then
  need_qml6
  if [ -n "$check" ]; then
    echo "lottie --check: would run ${QML6:-qml6} $entry $*" >&2
    exit 0
  fi
  exec "${QML6:-qml6}" "$entry" "$@"
fi

if [ -n "$check" ]; then
  ljos="$(built_program -p ljos_cli --bin ljos)"
  if [ "$entry" = "$file" ]; then
    check_run "$ljos" run "$entry" "$@"
    exit
  fi
  # A .json passes once it is Ready within the check, and fails on Error or
  # when it never gets there.
  log="$dir/check.log"
  status=0
  check_run "$ljos" run "$entry" "$@" > "$log" 2>&1 || status=$?
  cat "$log" >&2
  [ "$status" -eq 0 ] || exit "$status"
  if grep -q 'lottie --check: Error' "$log"; then
    die "lottie --check: $(basename "$file") did not load (LottieAnimation's status is Error)"
  fi
  grep -q 'lottie --check: Ready' "$log" ||
    die "lottie --check: $(basename "$file") was not Ready within ${LJOS_CHECK_SECONDS:-2} s"
  exit
fi
# Release by default: a debug build's frame times say nothing about how
# Lottie plays.
profile="${LOTTIE_PROFILE:-release}"
cargo build --quiet -p ljos_cli --bin ljos --profile "$profile"
dir="$profile"
[ "$profile" != dev ] || dir=debug
exec "$target/$dir/ljos" run "$entry" "$@"
