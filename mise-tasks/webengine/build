#!/usr/bin/env bash
#MISE description="Build ljos with QtWebEngine (CEF) and its helper beside it (on macOS, in ljos.app); CEF is fetched once into $CEF_PATH (default <target>/cef)"
set -euo pipefail
cd "$(dirname "$0")/../.."
target="${CARGO_TARGET_DIR:-$PWD/target}"
# The cef crate downloads CEF's minimal distribution (about 1.5 GB unpacked)
# into CEF_PATH when it isn't there yet, and copies the runtime beside the
# binaries. Left unset it would land in OUT_DIR and be fetched again after
# every clean, so it gets a place of its own.
export CEF_PATH="${CEF_PATH:-$target/cef}"
# The helper is a separate binary CEF starts its renderer, GPU and utility
# processes from; `ljos` looks for it beside itself (on macOS the bundler
# puts both in ljos.app). One build of all three: two builds resolve the
# crates they share with different features, and each rebuilt what the
# other had built, every time.
cargo build --quiet -p ljos_webengine --bin ljos-webengine-helper --bin ljos-webengine-bundle \
  -p ljos_cli --bin ljos --features ljos_webengine/cef,ljos_cli/webengine
# On Linux the libraries the build script copied beside the binaries ship unstripped: libcef.so
# is 1.48 GB, most of it DWARF, and 278 MB stripped. The copies are stripped;
# the original in CEF_PATH keeps its symbols for symbolising a crash (see the script).
scripts/strip-cef-runtime.sh "$target/debug"
if [ "$(uname -s)" = Darwin ]; then
  # On macOS CEF is a framework inside an application bundle, with helper
  # applications it starts its processes from: ljos.app, run from inside.
  # The framework is linked, not copied, as this bundle stays here.
  # The framework of the CEF version the cef crate is built against: an
  # older one stays under CEF_PATH after a bump.
  cef_version=$(awk '$0 == "name = \"cef\"" { getline; print }' Cargo.lock | sed -E 's/.*\+([^"]+)".*/\1/')
  arch=$(uname -m)
  [ "$arch" = arm64 ] && arch=aarch64
  framework="$CEF_PATH/$cef_version/cef_macos_$arch/Chromium Embedded Framework.framework"
  pick=()
  [ -d "$framework" ] && pick=(--framework "$framework")
  app=$("$target/debug/ljos-webengine-bundle" "$target/debug/ljos" --link-framework ${pick[@]+"${pick[@]}"})
  echo "built $app/Contents/MacOS/ljos with QtWebEngine (CEF from $CEF_PATH)"
else
  echo "built $target/debug/ljos with QtWebEngine (CEF from $CEF_PATH)"
fi
