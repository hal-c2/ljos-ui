#!/usr/bin/env bash
#MISE description="Run a QML file with QtWebEngine: webengine:run <file.qml> [ljos run args…] (try examples/webbrowser/Main.qml)"
#MISE dir="{{config_root}}"
#USAGE arg "<file>" help="QML file to run (try examples/webbrowser/Main.qml)"
#USAGE arg "[args]..." var=#true help="Arguments for ljos run after the file"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../_lib/env.sh
. "$(dirname "$0")/../_lib/env.sh"
cd "$ljos_root"
[ $# -gt 0 ] || die "usage: mise run webengine:run <file.qml> [ljos run args…]"
# The file is meant from where it was typed; the task runs from the root.
file="$(from_asked "$1")"
shift
[ -f "$file" ] || die "webengine:run: no such file: $file"
set -- "$file" "$@"
mise-tasks/webengine/build >&2
target="$(target_dir)"
if [ "$(uname -s)" = Darwin ]; then
  # A development run is not the application the person trusts with the
  # login keychain: without this a profile on disk has macOS ask for
  # their password for "Chromium Safe Storage" (#586).
  export LJOS_WEBENGINE_CHROMIUM_FLAGS="${LJOS_WEBENGINE_CHROMIUM_FLAGS:-} --use-mock-keychain"
  # The bundle webengine:build made (see there).
  exec "$target/debug/ljos.app/Contents/MacOS/ljos" run "$@"
fi
exec "$target/debug/ljos" run "$@"
