#!/usr/bin/env bash
#MISE description="Run a QML file with QtWebEngine: webengine:run <file.qml> [ljos run args…] (try examples/webbrowser/Main.qml)"
#USAGE arg "<file>" help="QML file to run (try examples/webbrowser/Main.qml)"
#USAGE arg "[args]..." var=#true help="Arguments for ljos run after the file"
set -euo pipefail
cd "$(dirname "$0")/../.."
(($#)) || { echo "usage: mise run webengine:run <file.qml> [ljos run args…]" >&2; exit 2; }
mise-tasks/webengine/build >&2
target="${CARGO_TARGET_DIR:-$PWD/target}"
if [ "$(uname -s)" = Darwin ]; then
  # The bundle webengine:build made (see there).
  exec "$target/debug/ljos.app/Contents/MacOS/ljos" run "$@"
fi
exec "$target/debug/ljos" run "$@"
