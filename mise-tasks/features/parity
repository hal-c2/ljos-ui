#!/usr/bin/env bash
#MISE description="Run @qt-parity scenarios on real Qt (qml6, offscreen); backlog expectations are verified too. Takes features:run's arguments."
#USAGE flag "-t --tags <tagexpr>" help="Only scenarios matching the tag expression"
#USAGE flag "-n --name <regex>" help="Only scenarios whose name matches"
#USAGE arg "[globs]..." var=#true help="Paths under features/, as for features:run"
set -euo pipefail
command -v "${QML6:-qml6}" >/dev/null || { echo "qml6 not found; install Qt 6 or set QML6" >&2; exit 1; }
exec "$(dirname "$0")/run" --backend qt "$@"
