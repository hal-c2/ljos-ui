#!/usr/bin/env bash
#MISE description="Test the acceptance mechanism end to end on the example suite (pass, regression, --raise, wrong commit, empty glob)"
#MISE dir="{{config_root}}"
#USAGE arg "[args]..." var=#true help="Arguments for cargo test (a test name filter; mise takes the first --, so test-binary options go after -- --, as in -- -- --nocapture)"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../_lib/env.sh
. "$(dirname "$0")/../_lib/env.sh"
root="$ljos_root"
dir="$root/acceptance/example"
[ -f "$dir/steps/Cargo.lock" ] || cp "$root/Cargo.lock" "$dir/steps/Cargo.lock"
CARGO_TARGET_DIR="$(target_dir)"
export CARGO_TARGET_DIR
exec cargo test --quiet --manifest-path "$dir/steps/Cargo.toml" "$@"
