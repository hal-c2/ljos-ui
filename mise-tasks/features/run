#!/usr/bin/env bash
#MISE description="Run part of the ledger: features:run [--backend ljos|qt|both] [globs…] [-t tagexpr] [-n name-regex]"
#MISE depends=[]
set -euo pipefail
# A glob is a path under features/, with or without that prefix (a directory, a file, or a *.feature pattern).
# cucumber takes a single --input, so the paths become one {a,b} glob.
# Everything else is passed through (-t, -n, --backlog).
args=()
globs=()
while [ $# -gt 0 ]; do
  case "$1" in
    --backend) export LJOS_BDD_BACKEND="$2"; shift 2 ;;
    -t|--tags|-n|--name|--input|-i) args+=("$1" "$2"); shift 2 ;;
    -*) args+=("$1"); shift ;;
    *)
      # Shell completion gives features/bindings; accept that too.
      g="${1#features/}"; shift
      if [ -d "features/$g" ]; then
        g="${g%/}/**/*.feature"
      elif [ -f "features/$g" ]; then
        # One file is that file, not every file of its name below its directory.
        :
      else
        g="$(dirname "$g")/**/$(basename "${g%.feature}").feature"
      fi
      globs+=("$g")
      ;;
  esac
done
# Always in braces: a path without a pattern in it is matched by nothing.
if [ ${#globs[@]} -gt 0 ]; then
  args+=(--input "$PWD/features/{$(IFS=,; echo "${globs[*]}")}")
fi

# @desktop scenarios run Ljós on a real compositor: the desktop sandbox (scripts/cua-sandbox.sh),
# headless and on its own bus, of its own here so that a sandbox someone drives is left alone.
# It is started only when the selected files have such a scenario, and stopped after the run.
# Without it the runner leaves them out and says why.
# LJOS_BDD_CARGO_FEATURES picks optional features of ljos_bdd, as
# `webengine`, which runs the @chromium scenarios on CEF; its helper is
# built first, beside the test.
features=()
if [ -n "${LJOS_BDD_CARGO_FEATURES:-}" ]; then
  features=(--features "$LJOS_BDD_CARGO_FEATURES")
  case ",$LJOS_BDD_CARGO_FEATURES," in
    *,webengine,*) cargo build --quiet -p ljos_webengine --features cef --bin ljos-webengine-helper ;;
  esac
fi

# LJOS_BDD_FEATURES_BIN is a features test built before, as CI builds it once
# for all its shards; LJOS_BIN and LJOS_FUZZ_BIN then name the programs
# its steps run. Without it the test is built here. It runs where cargo
# would run it, in its package's directory.
if [ -n "${LJOS_BDD_FEATURES_BIN:-}" ]; then
  runner=(env -C "$PWD/crates/ljos_bdd" "$(realpath "$LJOS_BDD_FEATURES_BIN")")
else
  runner=(cargo test --quiet -p ljos_bdd "${features[@]}" --test features --)
fi

desktop=
if [ "${LJOS_BDD_BACKEND:-ljos}" != qt ]; then
  shopt -s globstar nullglob
  files=()
  if [ ${#globs[@]} -eq 0 ]; then
    files=(features/**/*.feature)
  else
    # shellcheck disable=SC2206 # the glob is meant to expand
    for g in "${globs[@]}"; do files+=(features/$g); done
  fi
  shopt -u globstar nullglob
  if [ ${#files[@]} -gt 0 ] && grep -qs '@desktop' "${files[@]}"; then
    desktop=1
  fi
fi
if [ -n "$desktop" ]; then
  target="${CARGO_TARGET_DIR:-$PWD/target}"
  export LJOS_CUA_HOME="$target/cua-features"
  mkdir -p "$target/features"
  if why=$(scripts/cua-sandbox.sh env 2>&1 > "$target/features/desktop.env"); then
    # Built once here, outside the test, which then runs this one: a build
    # from inside it would be told the test's package (see testrun.rs).
    if [ -z "${LJOS_BIN:-}" ]; then
      cargo build --quiet -p ljos_cli --bin ljos
      export LJOS_BIN="$target/debug/ljos"
    fi
    export LJOS_BDD_DESKTOP="$target/features/desktop.env"
    trap 'scripts/cua-sandbox.sh stop' EXIT
  else
    export LJOS_BDD_DESKTOP_SKIP="${why##*$'\n'}"
  fi
  "${runner[@]}" "${args[@]}"
else
  export LJOS_BDD_DESKTOP_SKIP=
  exec "${runner[@]}" "${args[@]}"
fi
