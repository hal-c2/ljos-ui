#!/usr/bin/env bash
#MISE description="Run part of the ledger: features:run [--backend ljos|qt|both] [globs…] [-t tagexpr] [-n name-regex]. @desktop scenarios get a desktop sandbox of their own (scripts/cua-sandbox.sh), and LJOS_BDD_CARGO_FEATURES=webengine runs @chromium ones on CEF"
#MISE depends=[]
#MISE dir="{{config_root}}"
#USAGE flag "--backend <backend>" help="Engine the scenarios run on (default: LJOS_BDD_BACKEND, else ljos)" { choices "ljos" "qt" "both"; }
#USAGE flag "-t --tags <tagexpr>" help="Only scenarios matching the tag expression"
#USAGE flag "-n --name <regex>" help="Only scenarios whose name matches"
#USAGE flag "--backlog" help="Run only backlog work"
#USAGE arg "[globs]..." var=#true help="Paths under features/ (directories, files or *.feature patterns), with or without the features/ prefix"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../_lib/env.sh
. "$(dirname "$0")/../_lib/env.sh"
# CI runs this as a plain script; the paths are the repository's.
cd "$ljos_root"
target="$(target_dir)"
# A glob is a path under features/, with or without that prefix (a directory, a file, or a *.feature pattern).
# cucumber takes a single --input, so the paths become one {a,b} glob.
# Everything else is passed through (-t, -n, --backlog).
args=()
globs=()
input=
while [ $# -gt 0 ]; do
  case "$1" in
    --backend)
      [ $# -ge 2 ] || die "features:run: --backend needs ljos, qt or both"
      export LJOS_BDD_BACKEND="$2"
      shift 2
      ;;
    -t | --tags | -n | --name)
      [ $# -ge 2 ] || die "features:run: $1 needs a value"
      args+=("$1" "$2")
      shift 2
      ;;
    --input | -i)
      # A relative glob is from where mise was started, as every path here.
      [ $# -ge 2 ] || die "features:run: $1 needs a glob"
      input="$(from_asked "$2")"
      shift 2
      ;;
    --input=*) input="$(from_asked "${1#--input=}")"; shift ;;
    -*)
      args+=("$1")
      shift
      ;;
    *)
      # Shell completion gives features/bindings; accept that too.
      g="${1#features/}"
      shift
      if [ -d "features/$g" ]; then
        g="${g%/}/**/*.feature"
      elif [ -f "features/$g" ]; then
        # One file is that file, not every file of its name below its directory.
        :
      else
        g="$(dirname "$g")/**/$(basename "${g%.feature}").feature"
      fi
      globs+=("$g")
      ;;
  esac
done
# The ledger matches its one --input as a glob, and a path with no pattern
# in it is matched by nothing: a file or directory given as --input becomes
# a glob, as a path does. One under features/ joins the paths in the one
# {a,b} glob; one outside it cannot be joined with them. Compared as
# physical paths, as a symbolic link may lead to the checkout.
root="$(pwd -P)"
# A file's name as a pattern that matches only it: each pattern character
# in a class of its own ([,] is a comma), as the ledger's glob reads one.
glob_quote() {
  printf '%s' "$1" | sed 's/[][*?{},]/[&]/g'
}
asked="$input"
if [ -n "$input" ]; then
  if [ -d "$input" ]; then
    input="$(physical "$input")/**/*.feature"
  elif [ -f "$input" ]; then
    input="$(physical "$(dirname "$input")")/{$(glob_quote "$(basename "$input")")}"
  elif [ "${input%%[*?{[]*}" = "$input" ]; then
    die "features:run: --input $asked is no file or directory"
  else
    # A pattern: the directory before its first pattern character.
    lead="${input%%[*?{[]*}"
    lead="${lead%/*}"
    [ -z "$lead" ] || ! [ -d "$lead" ] || input="$(physical "$lead")${input#"$lead"}"
  fi
  case "$input" in
    "$root/features/"*)
      globs+=("${input#"$root/features/"}")
      input=
      ;;
    *) [ ${#globs[@]} -eq 0 ] || die "features:run: --input $asked is outside features/, so it cannot join the paths in the one --input the ledger takes" ;;
  esac
fi
# Always in braces: a path without a pattern in it is matched by nothing.
if [ ${#globs[@]} -gt 0 ]; then
  input="$root/features/{$(
    IFS=,
    echo "${globs[*]}"
  )}"
fi
[ -z "$input" ] || args+=(--input "$input")

# Qt runs off-screen; a desktop platform theme (gtk3, qt6ct) would still
# reach for a display.
[ "${LJOS_BDD_BACKEND:-ljos}" = ljos ] || unset QT_QPA_PLATFORMTHEME

# @desktop scenarios run Ljós on a real compositor: the desktop sandbox (scripts/cua-sandbox.sh),
# headless and on its own bus, of its own here so that a sandbox someone drives is left alone.
# It is started only when the selected files have such a scenario, and stopped after the run.
# Without it the runner leaves them out and says why.
# LJOS_BDD_CARGO_FEATURES picks optional features of ljos_bdd, as
# `webengine`, which runs the @chromium scenarios on CEF; its helper is
# built first, beside the test.
features=()
cef=
if [ -n "${LJOS_BDD_CARGO_FEATURES:-}" ]; then
  features=(--features "$LJOS_BDD_CARGO_FEATURES")
  case ",$LJOS_BDD_CARGO_FEATURES," in
    *,webengine,*)
      cef=1
      export CEF_PATH="${CEF_PATH:-$target/cef}"
      # @chromium runs headless (features/README.md), as on a machine with
      # no display: on a desktop Chromium would take the desktop's display
      # and pass what such a machine fails.
      export LJOS_WEBENGINE_CHROMIUM_FLAGS="${LJOS_WEBENGINE_CHROMIUM_FLAGS---ozone-platform=headless}"
      cargo build --quiet -p ljos_webengine --features cef --bin ljos-webengine-helper
      ;;
  esac
fi

# LJOS_BDD_FEATURES_BIN is a features test built before, as CI builds it once
# for all its shards; LJOS_BIN, LJOS_FUZZ_BIN and LJOS_PACKED_LOG_BIN then name the programs
# its steps run. Without it the test is built here. It runs where cargo
# would run it, in its package's directory.
bin=
if [ -n "${LJOS_BDD_FEATURES_BIN:-}" ]; then
  bin="$(from_asked "$LJOS_BDD_FEATURES_BIN")"
  [ -x "$bin" ] || die "LJOS_BDD_FEATURES_BIN is $LJOS_BDD_FEATURES_BIN, which is not a program"
fi
# It takes the shell it runs in: run it in a subshell where there is
# something to stop after it.
run_ledger() {
  if [ -n "$bin" ]; then
    cd "$ljos_root/crates/ljos_bdd"
    exec "$bin" "$@"
  else
    exec_cargo test --quiet -p ljos_bdd ${features[@]+"${features[@]}"} --test features -- "$@"
  fi
}
if [ -n "$cef" ]; then
  # CEF's libraries come unstripped, libcef.so at 1.48 GB (see the script). Either build may
  # run the cef crate's build script, which copies them again, so the test is built before
  # they are stripped, not by the run that loads them.
  [ -n "$bin" ] || cargo test --quiet --no-run -p ljos_bdd ${features[@]+"${features[@]}"} --test features
  scripts/strip-cef-runtime.sh "$target/debug"
fi

# The files the ledger reads, from the same --input it is given: the glob
# as a regular expression over the paths of the feature files (** is any
# directories, or none; * and ? stay within one; [..] is a class, [!..] its
# complement; {a,b} is either). Listed
# with find, not globstar, which macOS's bash 3.2 lacks, and matched as
# whole paths, so a directory's name may hold a space.
glob_regex() {
  awk '
  # Where the class opened at i closes; 0 if it does not. A ] first in the
  # class, after any !, is one of its characters.
  function class_end(s, i,    j) {
    j = i + 1
    if (substr(s, j, 1) == "!" || substr(s, j, 1) == "^") j++
    for (j++; j <= length(s); j++) if (substr(s, j, 1) == "]") return j
    return 0
  }
  {
    s = $0; out = ""; depth = 0
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == "*" && substr(s, i + 1, 2) == "*/") { out = out "(.*/)?"; i += 2 }
      else if (c == "*" && substr(s, i + 1, 1) == "*") { out = out ".*"; i++ }
      else if (c == "*") out = out "[^/]*"
      else if (c == "?") out = out "[^/]"
      else if (c == "[" && (j = class_end(s, i)) > 0) {
        body = substr(s, i + 1, j - i - 1)
        if (substr(body, 1, 1) == "!") body = "^" substr(body, 2)
        out = out "[" body "]"; i = j
      }
      else if (c == "{") { out = out "("; depth++ }
      else if (c == "}" && depth > 0) { out = out ")"; depth-- }
      else if (c == "," && depth > 0) out = out "|"
      else if (index("\\.^$+()|[]", c) > 0) out = out "\\" c
      else out = out c
    }
    print "^" out "$"
  }' <<<"$1"
}
# Searched from the input's own directory, the part before its first
# pattern character, so a suite outside features/ is read as well.
selected() {
  if [ -z "$input" ]; then
    find features -name '*.feature'
  else
    local from="${input%%[*?{[]*}"
    from="${from%/*}"
    [ -d "${from:-/}" ] || return 0
    find "${from:-/}" -name '*.feature' | grep -E "$(glob_regex "$input")" || true
  fi
}
# A selection that names no feature file would pass with 0 scenarios run.
if [ -n "$input" ] && [ -z "$(selected)" ]; then
  die "features:run: no feature file matches ${asked:-the paths given} (--input $input)"
fi
desktop=
if [ "${LJOS_BDD_BACKEND:-ljos}" != qt ]; then
  while IFS= read -r f; do
    if [ -n "$f" ] && grep -qs '@desktop' "$f"; then
      desktop=1
      break
    fi
  done < <(selected)
fi
if [ -n "$desktop" ]; then
  LJOS_CUA_HOME="$(checkout_dir cua-features)"
  export LJOS_CUA_HOME
  work="$(checkout_dir features)"
  mkdir -p "$work"
  if why=$(scripts/cua-sandbox.sh env 2>&1 >"$work/desktop.env"); then
    # Set before the build, so a build that fails stops the sandbox env started too.
    trap 'scripts/cua-sandbox.sh stop' EXIT
    # Built once here, outside the test, which then runs this one: a build
    # from inside it would be told the test's package (see testrun.rs). The
    # run keeps its own link to it, as another checkout may build into the
    # same target while the ledger runs (pin_programs).
    if [ -z "${LJOS_BIN:-}" ]; then
      programs="$(pin_programs "$work/bin" build --quiet -p ljos_cli --bin ljos)" || die "features: ljos did not build"
      LJOS_BIN="$(pinned_program ljos "$programs")"
      [ -n "$LJOS_BIN" ] || die "features: the build made no ljos"
      export LJOS_BIN
    fi
    export LJOS_BDD_DESKTOP="$work/desktop.env"
  else
    # env can fail after it started sway and its bus (a seat that never
    # got its keyboard, say). This sandbox is this run's own, so what it
    # started goes; the scenarios are skipped with env's word on why.
    scripts/cua-sandbox.sh stop > /dev/null 2>&1 || true
    export LJOS_BDD_DESKTOP_SKIP="${why##*$'\n'}"
  fi
  # A subshell, so that this shell lives to run the trap that stops the sandbox.
  (run_ledger ${args[@]+"${args[@]}"})
else
  export LJOS_BDD_DESKTOP_SKIP=
  # Nothing to stop after it: the ledger takes this task's process, so a
  # signal sent to the task reaches the ledger.
  run_ledger ${args[@]+"${args[@]}"}
fi
