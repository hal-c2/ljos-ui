#!/usr/bin/env bash
#MISE description="Start the ljos MCP authoring server on stdio for this repository (or the project given); it ends when its standard input closes"
#MISE dir="{{config_root}}"
#USAGE arg "[project]" help="Project directory the server authors, from where mise was started (default: this repository)"
# .mcp.json runs this too, so an editor or agent gets the same server as
# `mise run mcp`. It builds `ljos`, then becomes it. The server speaks
# JSON-RPC on stdout, so everything else (this script's word on which way it
# built, the build's own output) goes to stderr.
#
# Where the build goes is target_dir's (mise-tasks/_lib/env.sh), as for every
# task, in cargo's own order: CARGO_TARGET_DIR, else CARGO_BUILD_TARGET_DIR,
# else the build.target-dir cargo's settings name, else the main checkout's
# target/ (a linked worktree shares it rather than growing a build of its
# own); target_dir is where that order is kept. LJOS_BIN names a server
# built already and skips the build. LJOS_BUILD_WRAPPER names a program the
# build runs through (one that queues builds machine-wide, say); it wraps the
# build only, never the server, which runs for the whole session.
#
# The checkout is the one this runs in (mise runs it in the root), not the one
# the script came from.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=_lib/env.sh
. "$(dirname "$0")/_lib/env.sh"

say() { echo "mcp: $*" >&2; }

project="${usage_project:-${1:-}}"
# Nothing given is this repository; anything given (`.` too) is from where
# mise was started. .mcp.json's `.` is run in the root, so it is the root.
case "$project" in
  "") project="$PWD" ;;
  *) project="$(from_asked "$project")" ;;
esac
[ -d "$project" ] || die "mcp: no project directory $project"
project="$(physical "$project")"

if [ -n "${LJOS_BIN:-}" ]; then
  [ -x "$LJOS_BIN" ] || die "mcp: LJOS_BIN is $LJOS_BIN, which is not a program"
  say "starting $LJOS_BIN, built already (LJOS_BIN)"
  exec "$LJOS_BIN" mcp --project "$project"
fi

# The checkout this runs in, which need not be the one this script came from:
# its build goes where target_dir says for it (CARGO_TARGET_DIR as asked, not
# as env.sh resolved it for the script's own checkout), with its main
# checkout's cargo settings when it is a linked worktree (cargo_config).
if checkout="$(git rev-parse --show-toplevel 2>/dev/null)" && [ -n "$checkout" ]; then
  checkout="$(physical "$checkout")"
else
  checkout="$(pwd -P)"
fi
target="$(CARGO_TARGET_DIR="$ljos_asked_target_dir" target_dir "$checkout")" || exit 1
export CARGO_TARGET_DIR="$target"
# The settings file config_args writes lives until the build is over, or
# until this stops before it (exec runs no trap).
settings="$(mktemp -d "${TMPDIR:-/tmp}/ljos-cargo.XXXXXX")"
settings_gone() { rm -f "$settings/settings.toml" && rmdir "$settings" 2>/dev/null || true; }
trap settings_gone EXIT
main_settings="$(cargo_config "$checkout")" || exit 1
config_args "$main_settings" "$settings"
# The build is put together here, for that checkout: env.sh's cargo adds the
# script's own checkout's settings.
unset -f cargo

# --target-dir as well as CARGO_TARGET_DIR, for a build wrapper that clears
# the environment (config_args leaves the main checkout's build.target-dir
# out only while the variable is set). Cargo's messages name the program it
# made.
build=(cargo build --quiet -p ljos_cli --bin ljos
  --message-format=json-render-diagnostics --target-dir "$target"
  ${config_args[@]+"${config_args[@]}"})
# The toolchain is the one the checkout pins, not whichever cargo is first
# on PATH.
if [ -f "$checkout/mise.toml" ] && command -v mise >/dev/null 2>&1; then
  build=(mise exec -- "${build[@]}")
fi

if [ -n "${LJOS_BUILD_WRAPPER:-}" ]; then
  command -v "$LJOS_BUILD_WRAPPER" >/dev/null 2>&1 ||
    die "mcp: LJOS_BUILD_WRAPPER is $LJOS_BUILD_WRAPPER, which is not a program; unset it to build with cargo alone"
  say "building ljos through $LJOS_BUILD_WRAPPER into $target"
  build=("$LJOS_BUILD_WRAPPER" "${build[@]}")
else
  say "building ljos with cargo alone into $target; LJOS_BUILD_WRAPPER names a build wrapper to go through instead"
fi

cd "$checkout"
# The build's stdout is read here, never passed on: its JSON messages say
# where the program is (under a target triple when a build target is set).
# Its other lines (a wrapper's word on a busy queue, say) go to stderr as they
# come, not once the build is over (grep flushes each line, as the reader of
# stderr is a pipe more often than a terminal).
status=0
messages="$("${build[@]}" | tee >({ grep --line-buffered -v -e '^{"reason":' -e '^$' || true; } >&2))" || status=$?
settings_gone
[ "$status" -eq 0 ] || die "mcp: the build of ljos failed"
server="$(printf '%s\n' "$messages" | cargo_executable)"
[ -n "$server" ] && [ -x "$server" ] || die "mcp: the build named no ljos program it made"
exec "$server" mcp --project "$project"
