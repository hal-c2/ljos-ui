#!/usr/bin/env bash
#MISE description="Format check, clippy with warnings as errors, and the web build: check [-p pkg…] lints those packages only, without the web build"
set -euo pipefail
cargo fmt --all --check
if [ $# -eq 0 ]; then
  cargo clippy --workspace --all-targets -- -D warnings
  exec "$(dirname "$0")/wasm"
fi
cargo clippy "$@" --all-targets -- -D warnings
