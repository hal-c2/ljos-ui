rmdir "$real/wt/.cargo"
printf '[build]\njobs = 2\n' >"$repo/.cargo/config.toml"

# Settings a file includes are its settings, as cargo 1.98.1 reads them
# (checked against it): an array of paths ending in .toml, each a string or
# a table {path, optional}, from the directory of the file that names it.
# The included files merge first, each in the order listed, and the file's
# own keys win; a relative path in one is from the directory that holds its
# .cargo, as in any settings file.
mkdir -p "$repo/.cargo/inc/deep"
printf '[build]\ntarget-dir = "%s"\n' "$real/inc-a" >"$repo/.cargo/inc/a.toml"
printf '[build]\ntarget-dir = "%s"\n' "$real/inc-b" >"$repo/.cargo/inc/b.toml"
printf 'include = ["deep/d.toml"]\n' >"$repo/.cargo/inc/n.toml"
printf '[build]\ntarget-dir = "rel"\n' >"$repo/.cargo/inc/deep/d.toml"
settings_says "a target-dir an included file names is the one used" "$real/inc-a" 'include = ["inc/a.toml"]'
settings_says "a later include's target-dir wins over an earlier one's" "$real/inc-b" "include = [ 'inc/a.toml', \"inc/b.toml\" ]"
settings_says "the including file's own target-dir wins over its includes'" "$real/own" 'include = ["inc/b.toml"]' '[build]' "target-dir = \"$real/own\""
settings_says "an include given as a table, over lines, is read, and a missing optional one is skipped" "$real/inc-a" 'include = [' '  { path = "inc/none.toml", optional = true },  # not there' "  { path = 'inc/a.toml', optional = false }," ']'
settings_says "an included file's own include is from its directory, and its relative target-dir from the directory that holds its .cargo" "$repo/.cargo/inc/rel" 'include = ["inc/n.toml"]'
settings_says "an include under another table is not cargo's include" "$repo/target" '[build]' 'include = ["inc/a.toml"]'
# An include cargo stops on stops the task, in one line that names the file
# and what is wrong; it never goes round a cycle.
include_stops() {
  local what="$1" want="$2" got
  shift 2
  printf '%s\n' "$@" >"$repo/.cargo/config.toml"
  if got="$(where "$real/wt" 2>&1)"; then
    bad "$what: target_dir gave '$got' for settings:" "$@"
  elif [ "$(printf '%s\n' "$got" | wc -l | tr -d ' ')" = 1 ] && case "$got" in *"$repo/.cargo/"*"$want"*) true ;; *) false ;; esac; then
    ok "$what"
  else
    bad "$what: target_dir said, not one line naming the file and '$want':" "$got"
  fi
}
include_stops "an include given as a string stops the task, as cargo takes only an array" "not an array" 'include = "inc/a.toml"'
include_stops "an include that is not there stops the task unless it is optional" "inc/none.toml is not there" 'include = ["inc/a.toml", "inc/none.toml"]'
include_stops "an include not ending in .toml stops the task, as it stops cargo" "does not end with .toml" 'include = ["inc/a.txt"]'
printf 'include = ["../config.toml"]\n' >"$repo/.cargo/inc/c.toml"
include_stops "an include cycle stops the task rather than going round" "include cycle" 'include = ["inc/c.toml"]'
printf 'include = ["deep/../c2.toml"]\n' >"$repo/.cargo/inc/c2.toml"
include_stops "a file that includes itself by another path is a cycle" "include cycle" 'include = ["inc/c2.toml"]'
# Cargo takes a file met twice in one file's includes as a cycle, even met
# through two different files.
printf 'include = ["a.toml"]\n' >"$repo/.cargo/inc/x.toml"
printf 'include = ["a.toml"]\n' >"$repo/.cargo/inc/y.toml"
include_stops "a file two includes both include is a cycle, as cargo says" "include cycle" 'include = ["inc/x.toml", "inc/y.toml"]'
# A linked worktree is given the main checkout's settings with what they
# include, merged as cargo merges them; an include cargo stops on stops the
# task in one line there too, CARGO_TARGET_DIR set or not.
mkdir -p "$repo/.cargo/inc/tools"
printf '[build]\njobs = 4\nrustc-wrapper = "tools/w"\nrustflags = ["--cfg", "inc"]\n' >"$repo/.cargo/inc/k.toml"
printf 'include = [{ path = "inc/k.toml" }]\n[build]\njobs = 2\nrustflags = ["--cfg", "own"]\n' >"$repo/.cargo/config.toml"
want="build.jobs = 2|build.rustc-wrapper = \"$repo/.cargo/tools/w\"|build.rustflags = [\"--cfg\", \"inc\", \"--cfg\", \"own\"]|"
out="$(given "$real/wt")"
if [ "$out" = "$want" ]; then ok "a linked worktree gets what its main checkout's settings include, the including file's keys winning"; else bad "cargo in a worktree whose main settings include inc/k.toml was given:" "gave: $out" "not:  $want"; fi
if python3 -I -c 'import tomllib' 2>/dev/null || python3 -I -c 'import tomli' 2>/dev/null; then
  for case in 'include = ["inc/none.toml"]|is not there' 'include = ["inc/x.toml", "inc/y.toml"]|include cycle'; do
    printf '%s\n' "${case%|*}" >"$repo/.cargo/config.toml"
    if out="$( (unexported && CARGO_HOME="$real/cargo-home" cargo_config "$real/wt") 2>&1)"; then
      bad "cargo_config went on with settings cargo stops on (${case%|*}): $out"
    elif [ "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" = 1 ] && case "$out" in *"${case#*|}"*) true ;; *) false ;; esac; then
      ok "a main checkout's include cargo stops on (${case#*|}) stops a worktree's task in one line"
    else
      bad "cargo_config with settings that ${case#*|} said, not one line:" "$out"
    fi
  done
else
  echo "note  this python3 has no tomllib: a worktree's include that stops cargo is left out"
fi
rm -r "$repo/.cargo/inc"
printf '[build]\njobs = 2\n' >"$repo/.cargo/config.toml"

# Cargo reads settings in every directory above where it runs too, and in its
# home, after the checkout's own.
mkdir -p "$real/outer/.cargo" "$real/outer/plain" "$real/cargo-home"
printf '[build]\ntarget-dir = "outer-target"\n' >"$real/outer/.cargo/config.toml"
out="$(where "$real/outer/plain")"
if [ "$out" = "$real/outer/outer-target" ]; then ok "a target-dir in a directory above the checkout is the one used"; else bad "target_dir gave $out under $real/outer, whose .cargo/config.toml sets target-dir outer-target"; fi
printf '[build]\ntarget-dir = "%s"\n' "$real/home-target" >"$real/cargo-home/config.toml"
out="$(where "$real/outer/plain")"
if [ "$out" = "$real/outer/outer-target" ]; then ok "the settings above the checkout win over cargo's home"; else bad "target_dir gave $out under $real/outer with a target-dir in cargo's home too"; fi
out="$(where "$real/wt")"
if [ "$out" = "$real/home-target" ]; then ok "a target-dir in cargo's home is the one used when the checkout's settings name none"; else bad "target_dir gave $out for a worktree with target-dir $real/home-target in CARGO_HOME/config.toml"; fi
rm "$real/cargo-home/config.toml"

# A cargo task and the MCP server, both run in the worktree, build into the
# same place with the same settings. The stand-in cargo notes the target it
# would build into (--target-dir, else a build.target-dir --config, else
# CARGO_TARGET_DIR, else ./target as cargo's own) and the settings it was
# given with --config, in order, and makes a server there. It writes nothing outside
# the fixture: a target anywhere else is refused before anything is made.
fakes="$real/fakes"
mkdir "$fakes"
cat >"$fakes/cargo" <<'EOF_CARGO'
#!/bin/sh
target="${CARGO_TARGET_DIR:-$PWD/target}" config=""
while [ $# -gt 0 ]; do
  case "$1" in
    --target-dir) target="$2"; shift ;;
    --config)
      case "$2" in
        build.target-dir=*) target="${2#build.target-dir=\"}"; target="${target%\"}" ;;
        */settings.toml) while IFS= read -r line; do config="${config:+$config,}$line"; done <"$2" ;;
        *) config="${config:+$config,}$2" ;;
      esac
      shift
      ;;
  esac
  shift
done
case "$target" in
  "$FAKE_ROOT"/*) ;;
  *) echo "refused to build into $target, outside $FAKE_ROOT" >>"$FAKE_LOG"; exit 1 ;;
esac
echo "$target ${config:-none}" >>"$FAKE_LOG"
mkdir -p "$target/debug"
printf '#!/bin/sh\necho "{}"\n' >"$target/debug/ljos"
chmod +x "$target/debug/ljos"
printf '{"reason":"compiler-artifact","executable":"%s"}\n' "$target/debug/ljos"
EOF_CARGO
chmod +x "$fakes/cargo"
# cargo gives the main checkout's settings that no variable sets instead,
# looking at the variables at each call: one a task sets after env.sh was
# read wins too.
argfakes="$real/argfakes"
mkdir "$argfakes"
# The stand-in prints its arguments, a settings file as its lines in braces
# and whether only its user can read where it is.
cat >"$argfakes/cargo" <<'EOF_ARGS'
#!/bin/sh
for a in "$@"; do
  case "$a" in
    */settings.toml)
      printf '{'
      while IFS= read -r line; do printf '%s;' "$line"; done <"$a"
      printf '}%s|' "$(ls -ld "$(dirname "$a")" | cut -c1-10)"
      ;;
    /dev/fd/*)
      printf '{'
      while IFS= read -r line; do printf '%s;' "$line"; done <"$a"
      printf '}fd|'
      ;;
    *) printf '%s|' "$a" ;;
  esac
done
EOF_ARGS
chmod +x "$argfakes/cargo"
settings="$(printf 'CARGO_BUILD_JOBS\tbuild.jobs = 2\nCARGO_BUILD_TARGET_DIR CARGO_TARGET_DIR\tbuild.target-dir = "%s"' "$real/main-target")"
mkdir "$real/argtmp"
out="$( (unset CARGO_BUILD_JOBS CARGO_BUILD_TARGET_DIR && ljos_cargo_config="$settings" && TMPDIR="$real/argtmp" PATH="$argfakes:$PATH" cargo build) )"
if [ "$out" = "--config|{build.jobs = 2;}drwx------|build|" ]; then ok "in a worktree, cargo gets its main checkout's settings in a file only its user can read, but the target CARGO_TARGET_DIR names"; else bad "cargo in a worktree gave: $out"; fi
if [ -z "$(ls -A "$real/argtmp")" ]; then ok "the settings file is gone once cargo is"; else bad "cargo left behind: $(ls -A "$real/argtmp")"; fi
# exec_cargo: cargo takes the shell's process, and nothing is left behind.
out="$( (unset CARGO_BUILD_JOBS CARGO_BUILD_TARGET_DIR && ljos_cargo_config="$settings" && TMPDIR="$real/argtmp" PATH="$argfakes:$PATH" exec_cargo build; echo "still here|") )"
if [ -d /proc/self/fd ]; then
  want="--config|{build.jobs = 2;}fd|build|"
  if [ "$out" = "$want" ]; then ok "exec_cargo runs cargo in the shell's place with the main checkout's settings, read from a descriptor"; else bad "exec_cargo gave: $out" "not:  $want"; fi
  if [ -z "$(ls -A "$real/argtmp")" ]; then ok "exec_cargo leaves no settings file behind"; else bad "exec_cargo left behind: $(ls -A "$real/argtmp")"; fi
else
  case "$out" in
    "--config|{build.jobs = 2;}drwx------|build|") ok "exec_cargo runs cargo in the shell's place with the main checkout's settings, in a file only its user can read" ;;
    *) bad "exec_cargo gave: $out" ;;
  esac
fi
out="$( (unset CARGO_BUILD_TARGET_DIR && ljos_cargo_config="$settings" && CARGO_BUILD_JOBS=1 && export CARGO_BUILD_JOBS && PATH="$argfakes:$PATH" cargo build) )"
if [ "$out" = "build|" ]; then ok "a variable set after env.sh was read still wins over the main checkout's settings"; else bad "cargo given CARGO_BUILD_JOBS=1 after env.sh was read gave: $out"; fi
out="$( (unset CARGO_BUILD_JOBS CARGO_BUILD_TARGET_DIR && ljos_cargo_config="$settings" && CARGO_BUILD_JOBS=1 PATH="$argfakes:$PATH" cargo build) )"
if [ "$out" = "build|" ]; then ok "CARGO_BUILD_JOBS=1 cargo wins over the main checkout's jobs"; else bad "CARGO_BUILD_JOBS=1 cargo gave: $out"; fi
out="$( (unset CARGO_BUILD_JOBS CARGO_BUILD_TARGET_DIR && ljos_cargo_config="$settings" && CARGO_BUILD_JOBS=1 && PATH="$argfakes:$PATH" cargo build) )"
if [ "$out" = "--config|{build.jobs = 2;}drwx------|build|" ]; then ok "a CARGO_BUILD_JOBS the task does not export leaves the main checkout's jobs"; else bad "with CARGO_BUILD_JOBS=1 not exported, cargo gave: $out"; fi

# in_worktree <task>: the task, run from the worktree's copy of the tasks as
# mise would (in the worktree's root), with the stand-in cargo and cargo's
# home a fixture's, and no target asked for; prints what it noted.
in_worktree() {
  : >"$real/built.log"
  (
    cd "$real/wt"
    unset CARGO_TARGET_DIR CARGO_BUILD_TARGET_DIR LJOS_BIN LJOS_BUILD_WRAPPER CARGO_BUILD_TARGET CARGO_BUILD_JOBS
    CARGO_HOME="$real/cargo-home" FAKE_ROOT="$real" FAKE_LOG="$real/built.log" PATH="$fakes:$PATH" \
      bash "mise-tasks/$1" </dev/null >/dev/null 2>&1
  ) || echo "failed"
  cat "$real/built.log"
}
if [ -d "$real/wt" ]; then
  task="$(CARGO_BUILD_TARGET_DIR="$real/stray" in_worktree types)"
  mcp="$(in_worktree mcp)"
  if [ "$task" = "$repo/target build.jobs = 2" ] && [ "$task" = "$mcp" ]; then
    ok "a cargo task and the MCP server agree in a worktree: $repo/target, with its main checkout's settings"
  else
    bad "in a worktree, a cargo task and the MCP server built differently" "types: $task" "mcp:   $mcp"
  fi
  if [ ! -e "$real/wt/target" ]; then ok "nothing was built in the worktree's own target/"; else bad "the worktree has a target/ of its own"; fi
  mkdir "$real/wt/.cargo"
  printf '[build]\njobs = 3\n' >"$real/wt/.cargo/config"
  task="$(in_worktree types)"
  mcp="$(in_worktree mcp)"
  if [ "$task" = "$repo/target none" ] && [ "$task" = "$mcp" ]; then
    ok "with settings of its own, a worktree's cargo task and MCP server both build with its own keys over its main checkout's"
  else
    bad "in a worktree with settings of its own, a cargo task and the MCP server built differently" "types: $task" "mcp:   $mcp"
  fi
  rm "$real/wt/.cargo/config"
  rmdir "$real/wt/.cargo"
fi

# --- .mcp.json starts the server the way the tasks build ---------------------------

# taken <file>: mcp_json_problem accepts <file>, by its exit status as well
# as by saying nothing (a validator that fails says nothing on stdout).
# refused <file>: it exits 0 and says what is wrong.
taken() {
  local out
  out="$(mcp_json_problem "$1" 2>&1)" && [ -z "$out" ]
}
refused() {
  local out
  out="$(mcp_json_problem "$1" 2>/dev/null)" && [ -n "$out" ] && printf '%s\n' "$out"
}
if taken .mcp.json; then ok "this repository's .mcp.json starts its ljos server through mise-tasks/mcp"; else bad "this repository's .mcp.json:" "$(mcp_json_problem .mcp.json 2>&1)"; fi
printf '%s\n' '{"mcpServers":{"ljos":{"command":"cargo","args":["run","--quiet","-p","ljos_cli","--","mcp","--project","."]}}}' >"$real/old.json"
case "$(refused "$real/old.json")" in
  *"cargo run"*"mise-tasks/mcp"*) ok "an .mcp.json whose ljos server is a bare cargo run is refused, with the fix" ;;
  *) bad "an .mcp.json whose ljos server is a bare cargo run was not refused with the fix" "$(mcp_json_problem "$real/old.json" 2>&1)" ;;
esac
printf '%s\n' '{"mcpServers":{"ljos":{"command":"mise","args":["run","mcp"]}}}' >"$real/mise.json"
if taken "$real/mise.json"; then ok "an .mcp.json that starts its ljos server with mise run mcp is taken"; else bad "an .mcp.json running mise run mcp was refused" "$(mcp_json_problem "$real/mise.json" 2>&1)"; fi
printf '%s\n' '{"mcpServers":{"ljos":{"command":"bash","args":["mise-tasks/mcp","."]}}}' >"$real/bash.json"
if taken "$real/bash.json"; then ok "an .mcp.json that starts mise-tasks/mcp with bash is taken"; else bad "an .mcp.json running bash mise-tasks/mcp was refused" "$(mcp_json_problem "$real/bash.json" 2>&1)"; fi
printf '%s\n' '{"mcpServers":{"ljos":{"command":"sh","args":["mise-tasks/mcp","."]}}}' >"$real/sh.json"
case "$(refused "$real/sh.json")" in
  *bash*) ok "an .mcp.json that starts mise-tasks/mcp with sh, which may not be bash, is refused" ;;
  *) bad "an .mcp.json running sh mise-tasks/mcp was not refused" "$(mcp_json_problem "$real/sh.json" 2>&1)" ;;
esac
printf '%s\n' '{"mcpServers":{}}' >"$real/none.json"
case "$(refused "$real/none.json")" in
  *"no ljos server"*) ok "an .mcp.json with no ljos server is refused" ;;
  *) bad "an .mcp.json with no ljos server was not refused" ;;
esac
for args in null '"mise-tasks/mcp"' '{"a":1}'; do
  printf '{"mcpServers":{"ljos":{"command":"bash","args":%s}}}\n' "$args" >"$real/args.json"
  case "$(refused "$real/args.json")" in
    *"not a list"*) ok "an .mcp.json whose ljos server's args are $args is refused, not a validator that fails" ;;
    *) bad "an .mcp.json whose ljos server's args are $args was not refused" "$(mcp_json_problem "$real/args.json" 2>&1)" ;;
  esac
done
for server in '"command":"bash","args":["mise-tasks/mcp",null]' '"command":"bash","args":["mise-tasks/mcp",1]' '"command":["bash"],"args":["mise-tasks/mcp","."]'; do
  printf '{"mcpServers":{"ljos":{%s}}}\n' "$server" >"$real/args.json"
  case "$(refused "$real/args.json")" in
    *"not a string"*) ok "an .mcp.json whose ljos server is $server is refused: a command and its args are strings" ;;
    *) bad "an .mcp.json whose ljos server is $server was not refused" "$(mcp_json_problem "$real/args.json" 2>&1)" ;;
  esac
done

# --- A task runs cargo through env.sh ----------------------------------------------

mkdir "$real/lint"
# lints <what> <want: none|source|round> <line>…: what cargo_problems says of
# a task of those lines.
lints() {
  local what="$1" want="$2" got
  shift 2
  printf '%s\n' '#!/usr/bin/env bash' "$@" >"$real/lint/task"
  got="$(cargo_problems "$real/lint/task" "$real/lint")"
  case "$want:$got" in
    none:) ok "$what" ;;
    source:*"without sourcing"*) ok "$what" ;;
    round:*"goes round"*) ok "$what" ;;
    *) bad "$what: cargo_problems said '$got', not $want, of:" "$@" ;;
  esac
}
env_line='. "$(dirname "$0")/_lib/env.sh"'
lints "a task that sources env.sh and runs cargo is taken" none "$env_line" 'cargo test'
lints "a task that only prints a cargo command runs no cargo" none 'echo "Run cargo test first"'
lints "a task that runs cargo and does not source env.sh is refused" source 'cargo test'
lints "cargo in a condition or a command substitution is a cargo run" source 'if cargo test; then :; fi'
lints "cargo after an assignment is a cargo run" source 'x="$(RUSTFLAGS=-g cargo metadata)"'
lints "a commented-out source of env.sh does not count" source "# $env_line" 'cargo test'
lints "exec cargo goes round env.sh's cargo" round "$env_line" 'exec cargo test'
lints "exec_cargo is env.sh's cargo in the task's process" none "$env_line" 'exec_cargo test'
# shellcheck disable=SC1003 # the backslash ends the task's line
lints "command cargo across a continued line goes round env.sh's cargo" round "$env_line" 'command \' '  cargo test'
# A program that runs another runs the cargo program, not env.sh's cargo.
# shellcheck disable=SC2016 # the task's own text, expanded when it runs
for wrapped in 'timeout 60 cargo test' 'nice -n 10 cargo build' 'env X=1 cargo test' \
  '"$S/bin/capped" cargo build' '$S/bin/capped cargo build' 'command cargo test' \
  'nohup cargo build' 'mise exec -- cargo build' 'if timeout 60 cargo test; then :; fi' \
  'xargs cargo build' 'xargs -n 1 cargo build' 'taskset -c 0 cargo build' 'taskset 0x1 cargo build' \
  'chrt 1 cargo build' 'chrt -i 0 cargo build'; do
  lints "$wrapped, in a task that does not source env.sh, is refused" source "$wrapped"
  lints "$wrapped goes round env.sh's cargo" round "$env_line" "$wrapped"
done
lints "a message that names a wrapped cargo runs none" none 'echo "run timeout 60 cargo test"'
lints "a message that names cargo runs none" none 'echo "run cargo"'
lints "a message in single quotes after a separator runs none" none "printf '%s\n' 'built; cargo build'"
lints "a message that runs on over lines runs none" none 'echo "first line' 'cargo build"'
lints "an inline comment runs none" none ': built # ; cargo build'
lints "a here-document's text runs none" none "cat <<'EOF'" 'cargo build' 'EOF'
lints "an indented here-document's text runs none, and a cargo after its terminator is a cargo run" source 'cat <<-"END" | grep x' '	cargo run' '	END' 'cargo test'
lints "a shift in arithmetic is no here-document" source 'x=$((1 << n))' 'cargo test'
lints "cargo in a quoted command substitution is a cargo run" source 'x="$(timeout 60 cargo metadata)"'
# A wrapper takes its own options, and the next word is its program.
lints "exec of another program whose flag names cargo runs none" none 'exec "$prog" run --note "cargo build"'
lints "timeout of another program whose argument is cargo runs none" none 'timeout 60 "$prog" cargo'
lints "command -v cargo runs none" none 'command -v cargo >/dev/null || echo "no cargo"'
lints "exec -a names the program, and cargo after it goes round env.sh's cargo" round "$env_line" 'exec -a build cargo build'
# mise-tasks/bench/_default's last command, as it is there.
bench=(
  'exec "$target/$profile/ljos" bench --manifest "$manifest" \'
  '  --sway "$(value SWAYSOCK)" --wayland "$(value WAYLAND_DISPLAY)" \'
  '  --app-env "DBUS_SESSION_BUS_ADDRESS=$(value DBUS_SESSION_BUS_ADDRESS)" \'
  '  --app-env "XDG_CONFIG_HOME=$(value XDG_CONFIG_HOME)" --app-env "XDG_DATA_HOME=$(value XDG_DATA_HOME)" \'
  '  --app-env "XDG_STATE_HOME=$(value XDG_STATE_HOME)" \'
  '  --app-env "LJOS_SCREEN_READER=$(value LJOS_SCREEN_READER)" \'
  '  --qml6 "$qml" ${defaults[@]+"${defaults[@]}"} \'
  '  --note "ljos: $(git -C "$root" rev-parse --short HEAD), cargo build --profile $profile ($build)" \'
  '  --note "$qt_note" \'
  '  --note "both on the sandbox'"'"'s headless sway (${LJOS_CUA_GPU:-pixman}), as Wayland clients" \'
  '  --out "$out" ${opts[@]+"${opts[@]}"}'
)
lints "exec of the bench, whose note names cargo build, runs no cargo" none "${bench[@]}"
lints "exec of the bench, in a task that runs cargo, does not go round env.sh's cargo" none "$env_line" 'cargo build' "${bench[@]}"
# Longer than a pipe holds: a lint that pipes the task to grep -q sees the
# match fail under pipefail once grep stops reading.
long=()
for _ in $(seq 20000); do long+=(': filler line for a task longer than a pipe holds'); done
lints "a long task that sources env.sh and runs cargo is taken" none "$env_line" 'cargo test' "${long[@]}"
lints "a long task that runs exec cargo goes round env.sh's cargo" round "$env_line" 'exec cargo test' "${long[@]}"
# A task's scripts run with its environment, so a script's cargo builds
# where the task's settings say: the task sources env.sh for it.
mkdir "$real/lint/scripts"
printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' 'cargo build -p ljos_cli' >"$real/lint/scripts/build.sh"
printf '%s\n' '#!/usr/bin/env bash' 'echo "no cargo here"' >"$real/lint/scripts/quiet.sh"
lints "a task whose script runs cargo, and that does not source env.sh, is refused" source 'exec scripts/build.sh start "$@"'
lints "a task whose script runs cargo is taken when it sources env.sh" none "$env_line" 'exec scripts/build.sh start "$@"'
lints "a task whose script runs no cargo need not source env.sh" none '"$root/scripts/quiet.sh" "$out"'

# --- What a checkout's runs write ------------------------------------------------

if [ -d "$real/wt" ]; then
  main_dir="$( (unset CARGO_TARGET_DIR CARGO_BUILD_TARGET_DIR && CARGO_HOME="$real/cargo-home" checkout_dir gallery "$repo") )"
  wt_dir="$( (unset CARGO_TARGET_DIR CARGO_BUILD_TARGET_DIR && CARGO_HOME="$real/cargo-home" checkout_dir gallery "$real/wt") )"
  if [ "$main_dir" = "$repo/target/gallery" ]; then ok "the main checkout's runs write in its target directory"; else bad "checkout_dir gave $main_dir for the main checkout"; fi
  case "$wt_dir" in
    "$repo/target/worktrees/wt-"*/gallery) ok "a linked worktree's runs write in a directory of its own in the target it shares" ;;
    *) bad "checkout_dir gave $wt_dir for a linked worktree, not one under $repo/target/worktrees/" ;;
  esac
fi

# --- A long run keeps the programs it built ----------------------------------------

# The stand-in cargo here makes prog anew (a new file, as a linker does) on
# each build and says it was fresh only from build FRESH_FROM on: the builds
# before that are another checkout's, sharing the target, building between.
# A fresh build puts the checkout's own last program back, as cargo links it
# again from its deps; right after build OTHER_AFTER another checkout's
# program takes its place. With SAME set, a build that is not fresh makes the
# same program each time, as one whose build script watches a file that is
# not there does (qt_types' types.txt in a worktree that never ran setup).
pinfakes="$real/pinfakes"
mkdir "$pinfakes"
cat >"$pinfakes/cargo" <<'EOF_CARGO'
#!/bin/sh
n=$(( $(cat "$PIN_COUNT" 2>/dev/null || echo 0) + 1 ))
echo "$n" >"$PIN_COUNT"
fresh=false
[ "$n" -ge "$FRESH_FROM" ] && fresh=true || echo "build ${SAME:-$n}" >"$PIN_TARGET/mine"
rm -f "$PIN_TARGET/prog"
cp "$PIN_TARGET/mine" "$PIN_TARGET/prog"
if [ "$n" = "${OTHER_AFTER:-0}" ]; then rm -f "$PIN_TARGET/prog"; echo other >"$PIN_TARGET/prog"; fi
chmod +x "$PIN_TARGET/prog"
echo "Compiling prog (a line that is no message)"
printf '{"reason":"compiler-artifact","executable":null,"fresh":%s}\n' "$fresh"
printf '{"reason":"compiler-artifact","executable":"%s","fresh":%s}\n' "$PIN_TARGET/prog" "$fresh"
printf '{"reason":"build-finished","success":true}\n'
EOF_CARGO
chmod +x "$pinfakes/cargo"
out="$(printf '%s\n' '{"reason":"compiler-artifact","executable":null,"fresh":true}' \
  '{"reason":"compiler-artifact","executable":"/a\tb/say \"hi\"\\/prog","fresh":true}' \
  '{"reason":"compiler-artifact","executable":"/a\nb/prog","fresh":true}' \
  '{"reason":"build-finished","success":true}' | built_programs)"
if [ "$out" = "$(printf '/a\tb/say "hi"\\/prog')" ]; then ok "built_programs decodes each program's path, and leaves out none and one with a newline"; else bad "built_programs gave: $out"; fi

# pinned <fresh from> [other after]: builds, the program pinned, what it holds.
pinned() {
  local dir="$real/pin.$1"
  mkdir -p "$dir/target"
  (
    PATH="$pinfakes:$PATH" PIN_COUNT="$dir/count" PIN_TARGET="$dir/target" FRESH_FROM="$1" OTHER_AFTER="${2:-0}"
    export PATH PIN_COUNT PIN_TARGET FRESH_FROM OTHER_AFTER
    out="$(pin_programs "$dir/bin" build --quiet 2>/dev/null)" || { echo failed; exit 0; }
    printf '%s builds, %s: %s\n' "$(cat "$dir/count")" "$out" "$(cat "$dir/bin/prog" 2>/dev/null)"
  )
}
out="$(pinned 2)"
if [ "$out" = "2 builds, prog $real/pin.2/bin/prog: build 1" ]; then ok "a build no other checkout came between is pinned after one more build that finds it fresh"; else bad "pin_programs with no build between: $out"; fi
out="$(pinned 4)"
if [ "$out" = "4 builds, prog $real/pin.4/bin/prog: build 3" ]; then ok "a build another checkout's came between is built again until it is the run's own"; else bad "pin_programs with builds between: $out"; fi
rm -rf "$real/pin.2"
out="$(pinned 2 1)"
if [ "$out" = "3 builds, prog $real/pin.2/bin/prog: build 1" ]; then ok "a program another checkout's build put in place before it was pinned is pinned again from the build that finds it fresh"; else bad "pin_programs with another program in place of the build's: $out"; fi
out="$(SAME=again pinned 99)"
if [ "$out" = "2 builds, prog $real/pin.99/bin/prog: build again" ]; then ok "a build that is never fresh but makes the same program is pinned after one more build"; else bad "pin_programs with builds never fresh that make the same program: $out"; fi

programs="$(printf '%s\n' "ljos-x $real/a b/bin/ljos-x" "ljos $real/a b/bin/ljos" "qml-compare $real/a b/bin/qml-compare")"
out="$(pinned_program ljos "$programs")|$(pinned_program qml-compare "$programs")|$(pinned_program qml "$programs")"
if [ "$out" = "$real/a b/bin/ljos|$real/a b/bin/qml-compare|" ]; then ok "a pinned program's path is all of it, spaces and all"; else bad "pinned_program gave: $out"; fi

# --- Vulkan drivers --------------------------------------------------------------

mkdir -p "$real/icd" "$real/nvidia"
: >"$real/icd/radeon_icd.json"
# nvidia_left_out [VK_DRIVER_FILES]: what leave_out_absent_nvidia sets with no
# NVIDIA kernel driver and the manifests in $real/icd.
nvidia_left_out() {
  (
    unset VK_DRIVER_FILES VK_ICD_FILENAMES VK_ADD_DRIVER_FILES VK_LOADER_DRIVERS_SELECT VK_LOADER_DRIVERS_DISABLE
    [ -z "${1:-}" ] || export VK_DRIVER_FILES="$1"
    leave_out_absent_nvidia "$real/no-driver" "$real/icd"
    printf '%s' "${VK_LOADER_DRIVERS_DISABLE-unset}"
  )
}
if [ "$(uname -s)" = Linux ]; then
  out="$(nvidia_left_out)"
  if [ "$out" = unset ]; then ok "no NVIDIA manifest leaves the Vulkan loader as it is"; else bad "with no NVIDIA manifest, VK_LOADER_DRIVERS_DISABLE is $out"; fi
  : >"$real/icd/nvidia_icd.json"
  out="$(nvidia_left_out)"
  if [ "$out" = '*nvidia*' ]; then ok "NVIDIA's manifest without its kernel driver is left out"; else bad "NVIDIA's manifest without its kernel driver: VK_LOADER_DRIVERS_DISABLE is $out"; fi
  out="$(nvidia_left_out /x.json)"
  if [ "$out" = unset ]; then ok "drivers the user chose stand"; else bad "with VK_DRIVER_FILES set, VK_LOADER_DRIVERS_DISABLE is $out"; fi
  out="$(
    unset VK_DRIVER_FILES VK_ICD_FILENAMES VK_ADD_DRIVER_FILES VK_LOADER_DRIVERS_SELECT VK_LOADER_DRIVERS_DISABLE
    leave_out_absent_nvidia "$real/nvidia" "$real/icd"
    printf '%s' "${VK_LOADER_DRIVERS_DISABLE-unset}"
  )"
  if [ "$out" = unset ]; then ok "NVIDIA's driver is kept when its kernel driver is loaded"; else bad "with the kernel driver loaded, VK_LOADER_DRIVERS_DISABLE is $out"; fi
fi

# --- The checkout is as it was ---------------------------------------------------

if [ -s "$guard/refused" ]; then
  bad "tasks:test asked git to fetch or to change submodules (refused)" "$(cat "$guard/refused")"
else
  ok "tasks:test asked git to fetch nothing and to change no submodule"
fi
if [ -z "$checkout" ]; then
  ok "the checkout is not one git reads, so there is no checkout to compare"
elif ! checkout_after="$(checkout_state 2>&1)"; then
  bad "git could not read the checkout after tasks:test ran" "$checkout_after"
elif [ "$checkout_before" = "$checkout_after" ]; then
  ok "the checkout's submodules and tracked files are as they were"
else
  bad "the checkout's submodules or tracked files changed during tasks:test" "before:" "$checkout_before" "after:" "$checkout_after"
fi

exit "$failed"
