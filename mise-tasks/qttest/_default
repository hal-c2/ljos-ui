#!/usr/bin/env bash
#MISE description="Run QtTest files (tst_*.qml) on Ljós: ljos test <files or dirs> [-import <dir>] [--filter name]; with no arguments, the suite of crates/ljos_test/tests/qml"
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
if [ $# -eq 0 ]; then
  set -- "$root/crates/ljos_test/tests/qml/suite" -import "$root/crates/ljos_test/tests/qml/imports"
  # The suite saves a picture (`grabImage(...).save(name)`) into the current
  # directory, which must not be the checkout.
  work="${QTTEST_DIR:-${CARGO_TARGET_DIR:-$root/target}/qttest}"
  mkdir -p "$work"
  cd "$work"
fi
exec cargo run --quiet -p ljos_cli --bin ljos --manifest-path "$root/Cargo.toml" -- test "$@"
