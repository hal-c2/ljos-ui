#!/usr/bin/env bash
#MISE description="Build the ljos CLI (target/debug/ljos, or target/release/ljos with --release); --workspace builds every crate. QtWebEngine: mise run webengine:build"
#MISE dir="{{config_root}}"
#USAGE flag "--release" help="Optimised build, into target/release"
#USAGE flag "--workspace" help="Every crate of the workspace, not only ljos"
set -euo pipefail
args=()
[ "${usage_release:-false}" = true ] && args+=(--release)
if [ "${usage_workspace:-false}" = true ]; then
  args+=(--workspace)
else
  args+=(-p ljos_cli --bin ljos)
fi
cargo build "${args[@]}"
if [ "${usage_workspace:-false}" != true ]; then
  profile=debug
  [ "${usage_release:-false}" = true ] && profile=release
  echo "built ${CARGO_TARGET_DIR:-$PWD/target}/$profile/ljos"
fi
