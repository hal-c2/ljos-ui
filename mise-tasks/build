#!/usr/bin/env bash
#MISE description="Build the ljos CLI into the target directory (CARGO_TARGET_DIR, else CARGO_BUILD_TARGET_DIR, else the build.target-dir cargo's settings name, else target/; a linked worktree uses its main checkout's), as debug/ljos, or release/ljos with --release; --workspace builds every crate. QtWebEngine: mise run webengine:build"
#MISE dir="{{config_root}}"
#USAGE flag "--release" help="Optimised build, into release/ in the target directory"
#USAGE flag "--workspace" help="Every crate of the workspace, not only ljos"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=_lib/env.sh
. "$(dirname "$0")/_lib/env.sh"
cd "$ljos_root"
args=()
[ "${usage_release:-false}" = true ] && args+=(--release)
if [ "${usage_workspace:-false}" = true ]; then
  args+=(--workspace)
else
  args+=(-p ljos_cli --bin ljos)
fi
cargo build "${args[@]}"
if [ "${usage_workspace:-false}" != true ]; then
  profile=debug
  [ "${usage_release:-false}" = true ] && profile=release
  echo "built $(target_dir)/$profile/ljos"
fi
