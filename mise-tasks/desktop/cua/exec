#!/usr/bin/env bash
#MISE description="Run any command in the desktop:cua sandbox, starting it if needed: exec <command…> (mise run desktop:cua:exec mise run gallery:run <id> --mcp=inspect,input)"
#MISE dir="{{config_root}}"
#USAGE arg "<command>..." var=#true help="Command to run in the sandbox (e.g. mise run gallery:run <id>)"
set -euo pipefail
# The sandbox builds ljos where the tasks do, and has a home per checkout.
# shellcheck source-path=SCRIPTDIR source=../../_lib/env.sh
. "$(dirname "$0")/../../_lib/env.sh"
exec scripts/cua-sandbox.sh exec "$@"
