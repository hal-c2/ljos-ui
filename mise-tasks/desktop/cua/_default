#!/usr/bin/env bash
#MISE description="Run a Ljós app (ljos run <file.qml> [args]) in a headless sandbox off the user's screen: its own sway/XWayland, session bus and AT-SPI registry, plus cua-driver when it is on the PATH; run it again to relaunch the app"
#MISE dir="{{config_root}}"
#USAGE arg "<file>" help="QML file to run (ljos run <file>)"
#USAGE arg "[args]..." var=#true help="Arguments for ljos run after the file"
set -euo pipefail
exec scripts/cua-sandbox.sh start "$@"
