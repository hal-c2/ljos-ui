#!/usr/bin/env bash
#MISE description="Open a window that logs what drags from other applications carry (keys, urls, text, html, every format) and the action each drop is answered with; drag into it by hand. Any desktop; the log is kept in $CARGO_TARGET_DIR/drag-in.log (DRAG_IN_LOG). --check builds it and runs it for 2 s with no window"
#MISE dir="{{config_root}}"
#USAGE flag "--check" help="Build ljos and run the probe for 2 s with no window or display, then stop: fails when it does not build or load"
#USAGE arg "[args]..." var=#true help="Arguments for ljos run"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../_lib/env.sh
. "$(dirname "$0")/../_lib/env.sh"
cd "$ljos_root"
target="$(target_dir)"
check=
args=()
for a in "$@"; do
  if [ "$a" = --check ]; then check=1; else args+=("$a"); fi
done
cargo build --quiet -p ljos_cli --bin ljos
if [ -n "$check" ]; then
  check_run "$target/debug/ljos" run scripts/drag-in-probe.qml ${args[@]+"${args[@]}"}
  exit
fi
log="$(from_asked "${DRAG_IN_LOG:-$target/drag-in.log}")"
cat >&2 <<'HOW'
Drag into the window, then close it:
  left half:  takes anything with the action the source proposes
  right half: takes text/uri-list alone, as a link (text should be refused)
From a file manager: one file, then several (urls, keys).
From a text editor: plain text, then styled text (text, html or rtf among the keys).
Hold the platform's copy/move/link keys while dragging to change "proposed".
Leave without letting go to see "exited".
HOW
echo "logging to $log" >&2
"$target/debug/ljos" run scripts/drag-in-probe.qml ${args[@]+"${args[@]}"} 2>&1 | tee "$log"
echo "drag-in lines:" >&2
grep "drag-in:" "$log" >&2 || echo "(none: no drag reached a DropArea)" >&2
