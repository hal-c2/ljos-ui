#!/usr/bin/env bash
#MISE description="Use corpus examples as a person would, off-screen in the desktop:cua sandbox: click every control (or a grid of points), and list what each logged: gallery:drive [id…] (default: every example the last gallery run rendered)"
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
target="${CARGO_TARGET_DIR:-$root/target}"
out="${GALLERY_DIR:-$target/gallery}/drive"

ids=("$@")
if [ ${#ids[@]} -eq 0 ]; then
  report="${GALLERY_DIR:-$target/gallery}/report.json"
  [ -f "$report" ] || { echo "no $report: run \`mise run gallery\` first, or name the examples" >&2; exit 1; }
  mapfile -t ids < <(python3 -c 'import json, sys; [print(e["id"]) for e in json.load(open(sys.argv[1])) if e.get("renders")]' "$report")
fi

trap '"$root/scripts/cua-sandbox.sh" stop' EXIT
python3 "$root/scripts/gallery-drive.py" "$out" "${ids[@]}"
echo "per example: $out/<id>/report.txt and screenshots; all of it: $out/summary.txt"
