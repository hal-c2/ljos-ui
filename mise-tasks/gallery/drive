#!/usr/bin/env bash
#MISE description="Use corpus examples as a person would, off-screen in the desktop:cua sandbox: click every enabled control (or a grid of points), type into and edit every text field with keys, and list what each click and key did and what the app logged: gallery:drive [id…] (default: every example the last gallery run rendered)"
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
target="${CARGO_TARGET_DIR:-$root/target}"
out="${GALLERY_DIR:-$target/gallery}/drive"

ids=("$@")
if [ ${#ids[@]} -eq 0 ]; then
  report="${GALLERY_DIR:-$target/gallery}/report.json"
  [ -f "$report" ] || { echo "no $report: run \`mise run gallery\` first, or name the examples" >&2; exit 1; }
  mapfile -t ids < <(python3 -c 'import json, sys; [print(e["id"]) for e in json.load(open(sys.argv[1])) if e.get("renders")]' "$report")
fi

# The build gallery:run then runs (GALLERY_BUILT), in its profile.
profile="${GALLERY_PROFILE:-debug}"
if [ "$profile" = debug ]; then
  cargo build --quiet --manifest-path "$root/Cargo.toml" -p ljos_cli
else
  cargo build --quiet --manifest-path "$root/Cargo.toml" -p ljos_cli --profile "$profile"
fi
trap '"$root/scripts/cua-sandbox.sh" stop' EXIT
GALLERY_BUILT=1 python3 "$root/scripts/gallery-drive.py" "$out" "${ids[@]}"
echo "per example: $out/<id>/report.txt and screenshots; all of it: $out/summary.txt"
