#!/usr/bin/env bash
#MISE description="Edit corpus examples while they run under ljos run --watch, off-screen in the desktop:cua sandbox, and list what each save kept, lost and logged and how long it took to show: gallery:hot id… (each runs from a copy; the corpus is not written)"
#MISE dir="{{config_root}}"
#USAGE arg "<ids>..." var=#true help="Corpus example ids to edit while they run (mise run gallery:run lists them)"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../_lib/env.sh
. "$(dirname "$0")/../_lib/env.sh"
root="$ljos_root"
need_python3
need_corpus
target="$(target_dir)"
# A sandbox of its own (GALLERY_CUA_HOME), so stopping it at the end leaves
# alone one someone drives with desktop:cua.
LJOS_CUA_HOME="${GALLERY_CUA_HOME:-$(checkout_dir cua-gallery-hot)}"
export LJOS_CUA_HOME
out="${GALLERY_DIR:-$(checkout_dir gallery)}/hot"

[ $# -gt 0 ] || { echo "usage: mise run gallery:hot <id>… (mise run gallery:run lists the ids)" >&2; exit 1; }

# Every example runs the run's own link to this build (pin_programs): the
# target may be shared with another checkout, whose build during the run
# would otherwise put its ljos in place of this one.
profile=(--profile "${GALLERY_PROFILE:-debug}")
[ "${GALLERY_PROFILE:-debug}" != debug ] || profile=()
programs="$(pin_programs "$out/bin" build --quiet --manifest-path "$root/Cargo.toml" -p ljos_cli --bin ljos ${profile[@]+"${profile[@]}"})" || die "gallery:hot: ljos did not build"
LJOS_BIN="$(pinned_program ljos "$programs")"
[ -n "$LJOS_BIN" ] || die "gallery:hot: the build made no ljos"
export LJOS_BIN
trap '"$root/scripts/cua-sandbox.sh" stop' EXIT
python3 "$root/scripts/hot-drive.py" "$out" "$@"
echo "per example: $out/<id>/report.txt; all of it: $out/summary.md"
