#!/usr/bin/env bash
#MISE description="Run one qtdoc corpus example in a Ljós window: gallery:run <id> [ljos run args…]; no id lists the examples (* = rendered in the last gallery run)"
#USAGE flag "--list" help="List the examples (the same as giving no id)"
#USAGE arg "[id]" help="Corpus example id; none lists them (* = rendered in the last gallery run)"
#USAGE arg "[args]..." var=#true help="Arguments for ljos run (--watch, --top, --mcp=inspect,input, …)"
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
manifest="$root/corpus/examples.json"
target="${CARGO_TARGET_DIR:-$root/target}"
report="${GALLERY_DIR:-$target/gallery}/report.json"

if [ ! -d "$root/corpus/qtdoc" ]; then
  echo "no corpus at corpus/qtdoc (\`git submodule update --init corpus/qtdoc\`)" >&2
  exit 1
fi

# id <tab> dir <tab> entry <tab> WxH <tab> renders(yes/no/?) per example.
rows="$(python3 - "$manifest" "$report" <<'EOF'
import json, sys
manifest = json.load(open(sys.argv[1]))
renders = {}
try:
    for e in json.load(open(sys.argv[2])):
        renders[e["id"]] = "yes" if e.get("renders") else "no"
except OSError:
    pass
for e in manifest["examples"]:
    w = e.get("window") or {}
    size = f"{w.get('width', 800)}x{w.get('height', 600)}"
    print("\t".join([e["id"], e["dir"], e["entry"], size, renders.get(e["id"], "?")]))
EOF
)"

list() {
  while IFS=$'\t' read -r id _ _ _ renders; do
    mark=" "; [ "$renders" = yes ] && mark="*"
    printf '%s %s\n' "$mark" "$id"
  done <<< "$rows"
  echo "(* rendered in the last \`mise run gallery\`; run one with: mise run gallery:run <id> [--watch|--top|--mcp…])" >&2
}

if [ $# -eq 0 ] || [ "$1" = --list ]; then
  list
  exit 0
fi

id="$1"; shift
row=""
while IFS=$'\t' read -r rid dir entry size renders; do
  if [ "$rid" = "$id" ]; then row="$dir	$entry	$size	$renders"; break; fi
done <<< "$rows"
if [ -z "$row" ]; then
  echo "no example '$id' in corpus/examples.json; the examples are:" >&2
  list >&2
  exit 1
fi
IFS=$'\t' read -r dir entry _ renders <<< "$row"
if [ "$renders" = no ]; then
  echo "note: '$id' did not render in the last gallery run; trying anyway" >&2
fi

# The example's directory is its project, as it is for the gallery's
# renderer: an entry below it (`MediaPlayer/Main.qml`) finds the modules
# beside it, watched or not.
project=(--project "$root/corpus/qtdoc/$dir")

# The example's Qt build compiles its controls configuration in, which `qml` would not read.
if [ -f "$root/corpus/qtdoc/$dir/qtquickcontrols2.conf" ] && [ -z "${QT_QUICK_CONTROLS_CONF:-}" ]; then
  export QT_QUICK_CONTROLS_CONF="$root/corpus/qtdoc/$dir/qtquickcontrols2.conf"
fi

# corpus/standins/<id> is QML for the C++ types of the example's own build: each module there
# answers the import of its name.
standins=()
if [ -d "$root/corpus/standins/$id" ]; then
  while IFS= read -r qmldir; do
    module="$(sed -n 's/^module[[:space:]]\+//p' "$qmldir" | head -1)"
    standins+=(--alias "$module=$(dirname "$qmldir")")
  done < <(find "$root/corpus/standins/$id" -name qmldir -not -path '*/downloaded/*')
  # The C++ they stand in for reads the example's files; QML may only with this said.
  export QML_XHR_ALLOW_FILE_READ=1
fi

# gallery:drive builds once before its examples (GALLERY_BUILT=1): a build here, after a source
# changed or behind another cargo's lock on the target, would take the time the driver gives
# the example to start, and its examples would not all run the same build.
# GALLERY_PROFILE=release measures what a user gets; the default builds
# fastest.
profile="${GALLERY_PROFILE:-debug}"
if [ -z "${GALLERY_BUILT:-}" ]; then
  if [ "$profile" = debug ]; then
    cargo build --quiet --manifest-path "$root/Cargo.toml" -p ljos_cli --bin ljos
  else
    cargo build --quiet --manifest-path "$root/Cargo.toml" -p ljos_cli --bin ljos --profile "$profile"
  fi
fi
# An example's `file:content/…` is relative to the working directory, and a
# Qt build runs where it unpacked its assets: those of a stand-in's download
# are `content` of a directory of its own, the others are in the example's.
if grep -q "^  \"$id\":" "$root/corpus/assets.json"; then
  # gallery:drive looks for the inspector's token where it started this.
  export LJOS_MCP_DIR="${LJOS_MCP_DIR:-$PWD}"
  if [ -d "$root/corpus/standins/$id/downloaded" ]; then
    here="$target/gallery/cwd/$id"
    mkdir -p "$here"
    assets="$root/corpus/standins/$id/downloaded"
    [ -d "$assets/content" ] && assets="$assets/content"
    ln -sfn "$assets" "$here/content"
    cd "$here"
  else
    cd "$root/corpus/qtdoc/$dir"
  fi
fi

# The window is as large as the root says, as qml6 opens it; the manifest's
# size is the gallery's picture. A `--size` among the arguments sets one.
exec "$target/$profile/ljos" run "$root/corpus/qtdoc/$dir/$entry" \
  "${project[@]}" --example "$id" ${standins[@]+"${standins[@]}"} "$@"
