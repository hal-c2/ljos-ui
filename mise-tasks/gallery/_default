#!/usr/bin/env bash
#MISE description="Render the qtdoc corpus on Ljós (R backend, headless), score it against the qml6 pictures, write an HTML report and hold the committed ratchet"
set -euo pipefail
# Arguments: --raise (lift the ratchet, corpus/expected.json, to what scores
# now; a floor is never lowered), --top N (how many first errors to list),
# and example ids to run only those.
# Needs the pictures `mise run gallery:reference` makes (Qt-derived, never
# committed, so a checkout without them scores nothing and the ratchet has
# nothing to hold). Where the report goes: GALLERY_DIR, default target/gallery.
root="$(cd "$(dirname "$0")/../.." && pwd)"
target="${CARGO_TARGET_DIR:-$root/target}"
report="${GALLERY_DIR:-$target/gallery}"
mkdir -p "$report"
"$(dirname "$0")/build"

# What an example saves (Settings, LocalStorage) must not change the next run's picture: each
# run starts from empty config, data and state directories, with the user's fonts.
xdg="$report/xdg"
rm -rf "$xdg"
mkdir -p "$xdg/config" "$xdg/data" "$xdg/state"
if [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig" ]; then ln -s "${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig" "$xdg/config/fontconfig"; fi
if [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/fonts" ]; then ln -s "${XDG_DATA_HOME:-$HOME/.local/share}/fonts" "$xdg/data/fonts"; fi
export XDG_CONFIG_HOME="$xdg/config" XDG_DATA_HOME="$xdg/data" XDG_STATE_HOME="$xdg/state"

extra=()
top=10
ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --raise) extra+=(--raise) ;;
    --top) top="$2"; shift ;;
    *) ids+=("$1") ;;
  esac
  shift
done

# The shell wrapper keeps one slow or stuck example from stopping the run.
# --example registers the example's native backends (examples/gallery_backends)
# on the render Engine; an example without one registers nothing.
# --system-fonts: the qml6 pictures were drawn with this machine's fonts (a
# family such as Helvetica is the face fontconfig substitutes), so Ljós sets
# text in the same ones.
renderer="timeout -k 5 120 '$target/debug/ljos' render --system-fonts \"\$QML_COMPARE_DIR\" --entry \"\$QML_COMPARE_ENTRY\" --size \"\${QML_COMPARE_WIDTH}x\${QML_COMPARE_HEIGHT}\" --settle \"\$QML_COMPARE_SETTLE_MS\" --out {out} --example \"\$QML_COMPARE_ID\" \${QML_COMPARE_CAPTURED_AT:+--now \"\$QML_COMPARE_CAPTURED_AT\"}"

exec "$target/debug/qml-compare" run \
  --manifest "$root/corpus/examples.json" \
  --renderer "$renderer" \
  --ratchet "$root/corpus/expected.json" \
  --report-dir "$report" \
  --top "$top" \
  "${extra[@]}" "${ids[@]}"
