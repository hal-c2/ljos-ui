#!/usr/bin/env bash
#MISE description="Render the qtdoc corpus on Ljós (R backend, headless), score it against the qml6 pictures, write an HTML report and hold the committed ratchet"
#MISE dir="{{config_root}}"
#USAGE flag "--raise" help="Lift the ratchet (corpus/expected.json) to what scores now; a floor is never lowered"
#USAGE flag "--top <n>" default="10" help="How many first errors to list"
#USAGE arg "[ids]..." var=#true help="Corpus example ids to render (default: all)"
set -euo pipefail
# Arguments: --raise (lift the ratchet, corpus/expected.json, to what scores
# now; a floor is never lowered), --top N (how many first errors to list),
# and example ids to run only those.
# Needs the pictures `mise run gallery:reference` makes (Qt-derived, never
# committed, so a checkout without them scores nothing and the ratchet has
# nothing to hold). Where the report goes: GALLERY_DIR, default target/gallery.
# shellcheck source-path=SCRIPTDIR source=../_lib/env.sh
. "$(dirname "$0")/../_lib/env.sh"
root="$ljos_root"
need_corpus
need timeout "install GNU coreutils' timeout (macOS: brew install coreutils, which names it gtimeout: put its gnubin first on PATH)"
pictures=0
for png in "$root"/corpus/reference/*.png; do
  if [ -e "$png" ]; then
    pictures=1
    break
  fi
done
[ "$pictures" = 1 ] || die "gallery scores Ljós against qml6's pictures, and corpus/reference/ has none: mise run gallery:reference takes them (it needs qml6)"
target="$(target_dir)"
report="${GALLERY_DIR:-$target/gallery}"
mkdir -p "$report"
"$(dirname "$0")/build"

# Each run starts from an empty home, with the user's fonts (scripts/own-home.sh).
. "$root/scripts/own-home.sh"
own_home "$report/xdg"

extra=()
top=10
ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --raise) extra+=(--raise) ;;
    --top)
      [ $# -ge 2 ] || die "gallery: --top needs a number"
      top="$2"
      shift
      ;;
    *) ids+=("$1") ;;
  esac
  shift
done

# The shell wrapper keeps one slow or stuck example from stopping the run.
# --example registers the example's native backends (examples/gallery_backends)
# on the render Engine; an example without one registers nothing.
# --system-fonts: the qml6 pictures were drawn with this machine's fonts (a
# family such as Helvetica is the face fontconfig substitutes), so Ljós sets
# text in the same ones. --network: qml6 fetched what an example asks the
# network for (a feed, its pictures), so Ljós does too.
renderer="timeout -k 5 120 '$target/debug/ljos' render --system-fonts --network \"\$QML_COMPARE_DIR\" --entry \"\$QML_COMPARE_ENTRY\" --size \"\${QML_COMPARE_WIDTH}x\${QML_COMPARE_HEIGHT}\" --settle \"\$QML_COMPARE_SETTLE_MS\" --out {out} --example \"\$QML_COMPARE_ID\" \${QML_COMPARE_CAPTURED_AT:+--now \"\$QML_COMPARE_CAPTURED_AT\"}"

exec "$target/debug/qml-compare" run \
  --manifest "$root/corpus/examples.json" \
  --renderer "$renderer" \
  --ratchet "$root/corpus/expected.json" \
  --report-dir "$report" \
  --top "$top" \
  ${extra[@]+"${extra[@]}"} ${ids[@]+"${ids[@]}"}
