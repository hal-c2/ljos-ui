#!/usr/bin/env bash
#MISE description="Build the two programs the gallery runs (ljos and qml-compare); mise run gallery builds the same, and keeps its own links to them"
#MISE dir="{{config_root}}"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../_lib/env.sh
. "$(dirname "$0")/../_lib/env.sh"
cd "$ljos_root"
cargo build --quiet -p ljos_cli -p qml_compare
