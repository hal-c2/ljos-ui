#!/usr/bin/env bash
#MISE description="Generate crates/qt_types/src/types.txt from the local Qt's qmldir and .qmltypes files (git-ignored; --qt DIR, --module URI, --out FILE)"
#MISE sources=["crates/qmltypes/src/**/*.rs"]
#MISE outputs=["crates/qt_types/src/types.txt"]
#USAGE flag "--qt <dir>" var=#true help="Qt QML import directory (default: QML_IMPORT_PATH, then /usr/lib/qt6/qml); may repeat"
#USAGE flag "--module <uri>" var=#true help="Generate only this module; may repeat"
#USAGE flag "--out <file>" help="Where to write (default crates/qt_types/src/types.txt)"
set -euo pipefail
# The table is derived from Qt's install, so it stays on this machine (D1).
exec cargo run --quiet -p qmltypes -- "$@"
