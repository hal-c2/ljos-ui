#!/usr/bin/env bash
#MISE description="Every Rust test in the workspace (features run separately: mise run features)"
#USAGE arg "[args]..." var=#true help="Arguments for cargo test (--no-fail-fast, a test filter; mise takes the first --, so test-binary options go after -- --, as in -- -- --nocapture)"
set -euo pipefail
exec cargo test --workspace "$@"
