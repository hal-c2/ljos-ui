#!/usr/bin/env bash
#MISE description="First run after a clone, safe to repeat: mise.toml's tools (Rust 1.98.1 with its components and wasm target, cargo-nextest), the submodules, Qt's type table when Qt is here, CEF only with --webengine. Ends with what it did, what it skipped and what is missing, and fails when Rust is not mise.toml's. --check installs nothing"
#MISE dir="{{config_root}}"
#USAGE flag "--check" help="Install, fetch and build nothing: say what is there, what each task would lack, and whether this machine's Qt is the one CI pins; fail when something is missing or Qt is another minor version. Ask it as `mise run --skip-tools setup --check`, or mise first installs mise.toml's missing tools"
#USAGE flag "--webengine" help="Also build ljos with QtWebEngine (mise run webengine:build), which fetches CEF (about 1.5 GB unpacked) into $CEF_PATH"
#USAGE flag "--no-corpus" help="Leave out the qtdoc corpus submodule (gallery, parse and compile need it)"
#USAGE flag "--no-types" help="Do not generate Qt's type table (crates/qt_types/src/types.txt) even when Qt is found"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=_lib/env.sh
. "$(dirname "$0")/_lib/env.sh"
cd "$ljos_root"
# Never installs system packages and never uses sudo: what is missing is
# named, with what needs it and the one command that gets it.
# mise hands the flags over as usage_*; run as a plain script, they are read
# from the arguments, so `bash mise-tasks/setup --check` installs nothing too.
for arg in "$@"; do
  case "$arg" in
    --check) usage_check=true ;;
    --webengine) usage_webengine=true ;;
    --no-corpus) usage_no_corpus=true ;;
    --no-types) usage_no_types=true ;;
    *) die "setup takes --check, --webengine, --no-corpus and --no-types, not $arg" ;;
  esac
done
check="${usage_check:-false}"
done_list=""
skipped=""
missing=""
item() { printf '\n  - %s' "$1"; }
did() { done_list="$done_list$(item "$1")"; }
skip() { skipped="$skipped$(item "$1")"; }
lack() { missing="$missing$(item "$1")"; }

if [ "$check" = true ]; then
  # rustup's proxies install a missing toolchain when asked its version.
  export RUSTUP_AUTO_INSTALL=0
fi

# --- Rust ------------------------------------------------------------------

# Every build uses the rustc found here, so one that is not mise.toml's is
# missing, not skipped: it lacks the components and target CI builds with.
rust_report() {
  local why kind got parts=""
  if ! command -v rustup >/dev/null 2>&1; then
    lack "$(no_rustup)"
    return 0
  fi
  if why="$(wrong_rustc)" && [ -n "$why" ]; then
    lack "Rust: $why"
    return 0
  fi
  did "found $(rustc --version)"
  for kind in components targets; do
    if got="$(missing_rust_parts "$kind")"; then
      parts="$parts $got"
    else
      lack "Rust's $kind: rustup cannot list them for Rust $(rust_pin version); mise run setup installs it with them"
      return 0
    fi
  done
  parts="$(printf '%s' "$parts" | tr -s ' ' | sed 's/^ //; s/ $//')"
  if [ -n "$parts" ]; then
    lack "Rust's $parts (mise.toml): mise run setup adds them (mise install, through rustup)"
  else
    did "found Rust's $(rust_pin components) and $(rust_pin targets)"
  fi
}

if [ "$check" = true ]; then
  for tool in rust github:nextest-rs/nextest; do
    if at="$(mise where "$tool" 2>/dev/null)" && [ -d "$at" ]; then
      did "found mise's $tool ($at)"
    else
      lack "mise's $tool (mise.toml): mise run setup runs mise install"
    fi
  done
else
  echo "setup: mise install (the tools mise.toml pins)" >&2
  mise install --yes
  did "mise's tools (mise.toml): Rust $(rust_pin version), cargo-nextest"
fi
rust_report

# --- Submodules -------------------------------------------------------------

# The workspace builds FilmCraft's crates by path (QtMultimedia's decoders):
# nothing builds without it. Shallow, as CI fetches it.
submodule() {
  local path="$1" what="$2"
  if [ -f "$path/.git" ] || [ -d "$path/.git" ]; then
    did "found submodule $path ($what)"
  elif [ "$check" = true ]; then
    lack "submodule $path ($what): mise run setup fetches it (git submodule update --init --depth 1 $path)"
  else
    echo "setup: git submodule update --init --depth 1 $path" >&2
    git submodule update --init --depth 1 "$path"
    did "submodule $path ($what)"
  fi
}
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  submodule third_party/filmcraft "QtMultimedia's decoders; every build needs it"
  if [ "${usage_no_corpus:-false}" = true ]; then
    skip "submodule corpus/qtdoc (--no-corpus): gallery, gallery:run, parse and compile need it"
  else
    submodule corpus/qtdoc "the examples gallery, parse and compile read"
  fi
else
  skip "submodules: not a git checkout; fetch third_party/filmcraft and corpus/qtdoc yourself"
fi

# --- Qt ---------------------------------------------------------------------

# CI compares with one Qt (the install-qt-action steps of ci.yml). Another
# minor version here names other types and draws other pictures, so --check
# fails on it; a full setup says so and goes on, since most tasks never run Qt.
pin="$(qt_pin)"
mismatch="$(qt_mismatch)"
found="$(qt_found | sed -n 1p)"
if [ -n "$mismatch" ]; then
  while IFS= read -r line; do
    if [ "$check" = true ]; then lack "$line"; else skip "$line"; fi
  done <<EOF
$mismatch
EOF
elif [ -n "$found" ]; then
  did "found Qt ${found#* } (${found%% *}), CI's Qt ${pin%.*} (ci.yml pins $pin)"
else
  skip "Qt 6: none found (qmake6, qtpaths6, qml6). features:parity, gallery:reference, qttest, fuzz:qt and bench's Qt side need it: $(qt_pin_fix "$pin")"
fi

# Where Qt keeps its QML modules, as qmltypes reads them: every root of
# QML_IMPORT_PATH, then Qt's own (what qtpaths6 or qmake6 says, else the
# usual place). All of them go to `mise run types` as --qt, in that order.
roots=()
if [ -n "${QML_IMPORT_PATH:-}" ]; then
  IFS=: read -r -a imports <<<"$QML_IMPORT_PATH"
  for c in ${imports[@]+"${imports[@]}"}; do
    [ -n "$c" ] && [ -d "$c" ] && roots+=("$c")
  done
fi
own=()
for tool in qtpaths6 qmake6; do
  if command -v "$tool" >/dev/null 2>&1; then
    q="$("$tool" --query QT_INSTALL_QML 2>/dev/null || "$tool" -query QT_INSTALL_QML 2>/dev/null || true)"
    [ -n "$q" ] && own+=("$q")
  fi
done
own+=(/usr/lib/qt6/qml /usr/lib64/qt6/qml)
for c in "${own[@]}"; do
  if [ -f "$c/QtQuick/qmldir" ]; then
    roots+=("$c")
    break
  fi
done
# Qt is here when one of the roots has QtQuick.
qt_qml=""
for c in ${roots[@]+"${roots[@]}"}; do
  if [ -f "$c/QtQuick/qmldir" ]; then
    qt_qml="$c"
    break
  fi
done
qt_args=()
for c in ${roots[@]+"${roots[@]}"}; do qt_args+=(--qt "$c"); done

types="$ljos_root/crates/qt_types/src/types.txt"
if [ -n "${LJOS_QT_TYPES:-}" ]; then
  did "Qt's type table: LJOS_QT_TYPES=$LJOS_QT_TYPES is set, so builds take that (none = Ljós's own types only)"
elif [ -z "$qt_qml" ]; then
  skip "Qt's type table: no Qt 6 QML modules found (QML_IMPORT_PATH, qtpaths6, /usr/lib/qt6/qml). Builds read QML against Ljós's own types, as CI's LJOS_QT_TYPES=none does; install Qt (or set QML_IMPORT_PATH) and run mise run setup again for Qt's names in diagnostics"
elif [ -s "$types" ]; then
  did "Qt's type table: kept $types (mise run types -- ${qt_args[*]} regenerates it)"
elif [ "${usage_no_types:-false}" = true ] || [ "$check" = true ]; then
  skip "Qt's type table: Qt is at $qt_qml; mise run setup (or mise run types -- ${qt_args[*]}) makes it"
else
  echo "setup: Qt's type table from $qt_qml" >&2
  mise run types -- "${qt_args[@]}"
  did "Qt's type table from ${roots[*]} into $types (git-ignored)"
fi

# --- What some tasks need besides cargo ---------------------------------------

# Named, not installed: each is one task's, and the others run without it.
want() {
  local tool="$1" why="$2"
  command -v "$tool" >/dev/null 2>&1 || skip "$tool not found: $why"
}
want python3 "gallery, gallery:*, ci:changes, ci:test and bench need it, and desktop:cua gives its seat a keyboard with it"
want curl "accesskit:diff, quickjs:diff, oxc:diff and oxc:check fetch upstream with it"
want qml6 "features:parity, gallery:reference, fuzz:qt, lottie --qt and bench's Qt side run Qt 6's QML runtime"
if ! (find_qmltestrunner >/dev/null 2>&1); then
  skip "Qt 6's qmltestrunner not found: qttest:parity and bench:js run Qt's QML tests with it (or set QMLTESTRUNNER)"
fi
want sway "desktop:cua, features:run --backend desktop, gallery:drive, gallery:hot and bench run apps off-screen in a headless sway"
want Xwayland "desktop:cua's sandbox runs X11 apps through Xwayland"
want dbus-run-session "desktop:cua's sandbox gives each app a bus of its own"
find_atspi_registry >/dev/null || skip "at-spi2-registryd not found (at-spi2-core): desktop:cua's sandbox reads apps' accessibility tree through it"
want cua-driver "desktop:cua:call and gallery:drive click through apps with cua-driver"
want xdotool "desktop:cua:call's drags and long presses go through XTEST with xdotool"
want valgrind "bench:js and bench:hot count instructions with callgrind"
want nm "bench:hot reads ljos's symbols with nm (binutils)"
want systemd-run "bench and bench:cross hold each run to a memory and CPU budget with systemd-run"
want shellcheck "tasks:smoke lints every task with it"

if [ "${usage_webengine:-false}" != true ]; then
  skip "QtWebEngine (CEF, about 1.5 GB): mise run setup --webengine, or mise run webengine:build"
elif [ "$check" = true ]; then
  skip "QtWebEngine (--webengine): --check builds nothing; mise run webengine:build does"
else
  echo "setup: ljos with QtWebEngine (CEF)" >&2
  mise run webengine:build
  did "ljos with QtWebEngine; CEF in ${CEF_PATH:-$(target_dir)/cef}"
fi

verb=did
[ "$check" != true ] || verb=found
printf '\nsetup %s:%s\n' "$verb" "${done_list:-
  - nothing}"
if [ -n "$skipped" ]; then
  printf 'setup skipped:%s\n' "$skipped"
fi
if [ -n "$missing" ]; then
  printf 'setup is missing:%s\n' "$missing" >&2
  if [ "$check" = true ]; then
    echo "mise run setup gets what it can of these; each line says how to get the rest" >&2
  fi
  exit 1
fi
echo
echo "next: mise run check, mise run test, mise run dev (a QML app, reloaded on save), mise run install (ljos on your PATH)"
